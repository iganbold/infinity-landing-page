---
import Base from "@/layouts/Base.astro";
import { site, hero } from "@/content/site";
import { MARK } from "@/lib/mark";
import { hero as heroImage } from "@/lib/assets";

/** Not found: the hero's sunrise, dimmed, with "4∞4" and a way back. */
const copy = {
  title: "We couldn’t find that page",
  body: "The link may be old, or the page may have moved. Everything else is right where you left it.",
  home: { label: "Back to home", href: "/" },
};
---

<Base title={`Page not found — ${site.name}`}>
  <link slot="head" rel="preload" as="image" href={heroImage} fetchpriority="high" />
  <section class="nf" aria-labelledby="nf-title">
    <div class="photo" aria-hidden="true">
      <img src={heroImage} alt="" decoding="async" />
    </div>
    <div class="shade" aria-hidden="true"></div>

    <a href="/" class="brand" aria-label={`${site.name} home`}>{site.name.toLowerCase()}</a>

    <div class="body">
      <p class="code" aria-hidden="true">
        <span>4</span>
        <svg class="mark" viewBox="0 0 40 25">
          <defs>
            <linearGradient id="nf-g" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#ffcf7a"></stop>
              <stop offset=".45" stop-color="#d6f58a"></stop>
              <stop offset="1" stop-color="#4fe3b0"></stop>
            </linearGradient>
          </defs>
          <path d={MARK} fill="none" stroke="url(#nf-g)" stroke-width="3.4" stroke-linecap="round"></path>
        </svg>
        <span>4</span>
      </p>
      <h1 id="nf-title" class="title">{copy.title}</h1>
      <p class="lead">{copy.body}</p>
      <div class="actions">
        <a href={copy.home.href} class="btn btn--solid">
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M13 8H3M7 4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          {copy.home.label}
        </a>
        <a href={hero.cta.href} class="btn btn--ghost">{hero.cta.label}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 96px 24px;
    overflow: clip;
    text-align: center;
    background: var(--canvas-green);
    --cream: #f7f1e3;
  }

  /* The hero's sunrise, held still and dimmed, easing out of a slight zoom. */
  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: nf-zoom 5s cubic-bezier(0.33, 1, 0.68, 1) both;
  }
  @keyframes nf-zoom {
    from {
      transform: scale(1.14);
    }
    to {
      transform: scale(1.04);
    }
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 50% 48%, rgba(10, 14, 11, 0.45), transparent 100%),
      linear-gradient(to bottom, rgba(14, 22, 17, 0.55), rgba(14, 22, 17, 0.35) 40%, rgba(29, 58, 43, 0.85));
  }

  .brand {
    position: absolute;
    top: clamp(20px, 3.6vh, 36px);
    left: 50%;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--cream);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
    transform: translateX(-50%);
  }

  .body {
    display: grid;
    justify-items: center;
    max-width: 34rem;
  }
  /* "4∞4": the brand's mark stands in for the zero. */
  .code {
    display: flex;
    align-items: center;
    gap: 0.06em;
    margin: 0 0 18px;
    font-size: clamp(88px, 16vw, 168px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--cream);
    text-shadow: 0 10px 50px rgba(0, 0, 0, 0.45);
  }
  .mark {
    width: 1.28em;
    height: 0.8em;
    overflow: visible;
    filter: drop-shadow(0 0 18px rgba(214, 245, 138, 0.45));
    animation: nf-mark 3.2s ease-in-out infinite alternate;
  }
  @keyframes nf-mark {
    to {
      filter: drop-shadow(0 0 28px rgba(79, 227, 176, 0.6));
    }
  }
  .title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--cream);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
  }
  .lead {
    max-width: 30em;
    margin-top: 14px;
    text-wrap: balance;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    transition:
      background 250ms var(--ease),
      color 250ms var(--ease),
      box-shadow 250ms var(--ease);
  }
  .btn--solid {
    color: #17160f;
    background: var(--cream);
    box-shadow: 0 16px 40px -16px rgba(255, 214, 140, 0.55);
  }
  .btn--solid:hover {
    background: #ffffff;
  }
  .btn--ghost {
    color: var(--cream);
    box-shadow: inset 0 0 0 1px rgba(247, 241, 227, 0.45);
  }
  .btn--ghost:hover {
    background: rgba(247, 241, 227, 0.12);
  }
</style>
