---
import Base from "@/layouts/Base.astro";
import Logo from "@/components/Logo.astro";
import { bookDemo as b, footer, site } from "@/content/site";
import { COUNTRIES } from "@/lib/countries";

/** Server route that forwards requests to Slack (src/pages/api/demo-request.ts). */
const endpoint = "/api/demo-request";
const f = b.fields;
---

<Base title={`Request a demo — ${site.name}`} description={b.body}>
  <div class="split">
    <!-- Left: inset forest card with an animated Siri-style inner glow. -->
    <aside class="side" data-topo-panel>
      <canvas class="topo" aria-hidden="true" data-topo></canvas>
      <span class="glow" aria-hidden="true"></span>
      <span class="glow-ring" aria-hidden="true"></span>
      <a href="/" class="brand" aria-label={`${site.name} home`}><Logo size={26} tone="white" /></a>

      <div class="side-copy">
        <h1 class="title" data-reveal>{b.title}</h1>
        <p class="body" data-reveal style="--d:1">{b.body}</p>
      </div>

      <a href="/" class="back">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        {b.back}
      </a>
    </aside>

    <!-- Right: the form, directly on the page. -->
    <section class="main" aria-label="Contact form">
      <form class="form" data-demo-form data-endpoint={endpoint} novalidate data-reveal style="--d:1">
        <div class="row">
          <label class="field">
            <span>{f.firstName}<i aria-hidden="true">*</i></span>
            <input name="firstName" type="text" autocomplete="given-name" required />
          </label>
          <label class="field">
            <span>{f.lastName}<i aria-hidden="true">*</i></span>
            <input name="lastName" type="text" autocomplete="family-name" required />
          </label>
        </div>

        <label class="field">
          <span>{f.email}<i aria-hidden="true">*</i></span>
          <input name="email" type="email" autocomplete="email" required />
        </label>

        <div class="row">
          <label class="field">
            <span>{f.company}<i aria-hidden="true">*</i></span>
            <input name="company" type="text" autocomplete="organization" required />
          </label>
          <label class="field">
            <span>{f.role}<i aria-hidden="true">*</i></span>
            <input name="role" type="text" autocomplete="organization-title" required />
          </label>
        </div>

        <div class="row">
          <label class="field">
            <span>{f.size}<i aria-hidden="true">*</i></span>
            <span class="select">
              <select name="size" required>
                <option value="" disabled selected>{f.sizePlaceholder}</option>
                {f.sizes.map((sz) => <option value={sz}>{sz}</option>)}
              </select>
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </label>
          <label class="field">
            <span>{f.country}<i aria-hidden="true">*</i></span>
            <span class="select">
              <select name="country" autocomplete="country-name" required data-country>
                <option value="" disabled selected>{f.countryPlaceholder}</option>
                {COUNTRIES.map((c) => <option value={c.name} data-code={c.code}>{c.name}</option>)}
              </select>
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M2.5 4.5L6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </label>
        </div>

        <label class="field">
          <span>{f.outcome} <em>{f.optional}</em></span>
          <textarea name="outcome" rows="3" placeholder={f.outcomeHint}></textarea>
        </label>

        <!-- Honeypot: hidden from people, irresistible to bots. -->
        <label class="hp" aria-hidden="true">
          Website
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>

        <hr class="rule" />

        <div class="foot">
          <div class="consent">
            <label class="check">
              <input type="checkbox" name="optIn" />
              <span>{b.optIn}</span>
            </label>
            <p class="privacy">
              {b.privacy.label} <a href={b.privacy.href}>{b.privacy.link}</a>
            </p>
          </div>
          <button class="submit" type="submit">
            {b.submit}
            <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M4 12L12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>

        <p class="status" role="status" aria-live="polite" data-status></p>
        <p class="alt">Prefer email? <a href={footer.contact.href}>{footer.contact.label}</a></p>
      </form>

      <div class="sent" data-sent hidden>
        <span class="sent-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 16 16">
            <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <h2 tabindex="-1">{b.sent.title}</h2>
        <p>{b.sent.body}</p>
      </div>
    </section>
  </div>
</Base>

<script>
  import { mountTopography } from "@/scripts/topography";

  // Animated contour lines behind the green card, the same effect as the homepage footer.
  const side = document.querySelector<HTMLElement>("[data-topo-panel]");
  const topo = side?.querySelector<HTMLCanvasElement>("[data-topo]");
  if (side && topo) mountTopography(topo, { pointerTarget: side, opacity: 0.55 });
</script>

<script>
  import { bookDemo as b } from "@/content/site";
  import { ZONE_COUNTRY } from "@/lib/zone-country";

  // Pre-select the visitor's country. First an instant guess from the device's
  // time zone (then the browser language's region); then, where the host
  // provides IP geolocation, refine it via /api/geo. Never overrides a choice
  // the person has already made.
  const country = document.querySelector<HTMLSelectElement>("[data-country]");
  if (country) {
    let touched = false;
    country.addEventListener("change", () => (touched = true));
    const pick = (code: string | null | undefined) => {
      if (!code || touched) return false;
      const opt = country.querySelector<HTMLOptionElement>(`option[data-code="${code.toUpperCase()}"]`);
      if (!opt) return false;
      country.value = opt.value;
      return true;
    };
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    if (!pick(ZONE_COUNTRY[tz])) {
      for (const lang of navigator.languages ?? [navigator.language]) {
        const region = (() => {
          try {
            return new Intl.Locale(lang).maximize().region;
          } catch {
            return undefined;
          }
        })();
        if (pick(region)) break;
      }
    }
    fetch("/api/geo")
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => pick(d?.country))
      .catch(() => {});
  }

  const form = document.querySelector<HTMLFormElement>("[data-demo-form]");
  const sent = document.querySelector<HTMLElement>("[data-sent]");
  if (form && sent) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const endpoint = form.dataset.endpoint ?? "";
    // When the page loaded; the server rejects implausibly fast submissions.
    const startedAt = Date.now();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.className = "status";
      status.textContent = "";
      // Native validation; errors only show after the first attempt.
      if (!form.checkValidity()) {
        form.classList.add("tried");
        form.querySelector<HTMLElement>(":invalid")?.focus();
        return;
      }
      btn.disabled = true;
      try {
        const data = Object.fromEntries(new FormData(form));
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...data, optIn: data.optIn === "on", startedAt }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        sent.hidden = false;
        sent.querySelector<HTMLElement>("h2")?.focus();
      } catch {
        status.textContent = b.error;
        status.classList.add("warn");
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(360px, 40%) 1fr;
    min-height: 100svh;
    background: var(--canvas);
    /* Light page: native controls (checkbox, select menu) render light too. */
    color-scheme: light;
    --ink-dark: #16150f;
    --ink-mid: #57544a;
    --brand: #2f7a55;
    --forest: #1d3a2b;
  }

  /* ------------------------------------------------ left card */

  /* Registered so the glow's conic gradient can rotate smoothly. */
  @property --glow-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .side {
    position: sticky;
    top: 16px;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: calc(100svh - 32px);
    margin: 16px 0 16px 16px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: 28px;
    overflow: hidden;
    color: #f2f4ec;
    background:
      radial-gradient(70% 50% at 0% 0%, rgba(255, 214, 140, 0.14), transparent 70%),
      linear-gradient(160deg, #22432f 0%, var(--forest) 55%, #142a1e 100%);
    box-shadow: 0 40px 80px -44px rgba(20, 45, 30, 0.6);
  }

  /* Siri-style inner glow: a slowly rotating conic gradient cut to a thin
     band along the edges. The band lives on ::before (masked); the parent is
     blurred, so the light softens inward. Filters run before masks, which is
     why the blur can't sit on the masked layer itself. The card's overflow
     clips the outer half, so the glow only spills inside. */
  /* Contours sit under the edge glow; quieter behind the headline. */
  .topo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(90% 55% at 30% 50%, rgba(0, 0, 0, 0.35), #000 100%);
    mask-image: radial-gradient(90% 55% at 30% 50%, rgba(0, 0, 0, 0.35), #000 100%);
  }

  .glow,
  .glow-ring {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
  }
  .glow::before,
  .glow-ring::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(
      from var(--glow-angle),
      #ffcf7a,
      #d6f58a,
      #4fe3b0,
      #6cc4ff,
      #4fe3b0,
      #d6f58a,
      #ffcf7a
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: glow-spin 9s linear infinite;
  }
  .glow {
    filter: blur(18px) saturate(1.3);
    opacity: 1;
  }
  .glow::before {
    padding: 14px;
  }
  /* A tighter, brighter edge on top, softly blurred. */
  .glow-ring {
    filter: blur(3px);
    opacity: 0.9;
  }
  .glow-ring::before {
    padding: 3px;
  }
  @keyframes glow-spin {
    to {
      --glow-angle: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .glow::before,
    .glow-ring::before {
      animation: none;
    }
  }

  .brand {
    display: inline-flex;
    justify-self: start;
  }

  .side-copy {
    align-self: center;
    display: grid;
    gap: 20px;
  }
  .title {
    white-space: pre-line;
    font-size: clamp(38px, 3.4vw, 56px);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.035em;
    color: #ffffff;
  }
  .body {
    max-width: 34ch;
    font-size: 16px;
    line-height: 1.6;
    color: rgba(242, 244, 236, 0.74);
  }

  .back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 500;
    color: #f2f4ec;
    box-shadow: inset 0 0 0 1px rgba(242, 244, 236, 0.3);
    transition:
      background 250ms var(--ease),
      box-shadow 250ms var(--ease);
  }
  .back:hover {
    background: rgba(242, 244, 236, 0.08);
    box-shadow: inset 0 0 0 1px rgba(242, 244, 236, 0.5);
  }
  .back svg {
    transition: transform 300ms var(--ease);
  }
  .back:hover svg {
    transform: translateX(-3px);
  }

  /* ------------------------------------------------ form */

  .main {
    display: grid;
    align-items: center;
    padding: clamp(40px, 6vw, 96px) clamp(20px, 8vw, 120px);
  }
  .form,
  .sent {
    width: 100%;
    max-width: 640px;
    justify-self: center;
  }
  .form {
    display: grid;
    gap: 22px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    display: grid;
    gap: 8px;
  }
  .field > span:first-child {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-mid);
  }
  .field i {
    margin-left: 2px;
    font-style: normal;
    color: var(--brand);
  }
  .field em {
    margin-left: 4px;
    font-style: normal;
    font-size: 12.5px;
    color: #8a8577;
  }
  .field input,
  .field textarea,
  .field select {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    border: 0;
    border-radius: 12px;
    font: inherit;
    font-size: 16px;
    color: var(--ink-dark);
    background: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(22, 21, 15, 0.12);
    transition:
      box-shadow 200ms var(--ease),
      background 200ms var(--ease);
  }
  .field textarea {
    height: auto;
    min-height: 96px;
    padding: 13px 16px;
    resize: vertical;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #a29d8f;
  }
  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    box-shadow:
      inset 0 0 0 1.5px var(--brand),
      0 0 0 4px rgba(47, 122, 85, 0.12);
  }
  .tried .field :invalid {
    box-shadow: inset 0 0 0 1.5px #c0473a;
  }

  .select {
    position: relative;
    display: block;
  }
  .select select {
    appearance: none;
    padding-right: 40px;
    cursor: pointer;
  }
  .select select:invalid {
    color: #a29d8f;
  }
  .select svg {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-dark);
    pointer-events: none;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .rule {
    width: 100%;
    height: 1px;
    margin: 8px 0 0;
    border: 0;
    background: rgba(22, 21, 15, 0.14);
  }

  .foot {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .consent {
    display: grid;
    gap: 6px;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink-dark);
    cursor: pointer;
  }
  .check input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--brand);
    cursor: pointer;
  }
  .privacy {
    padding-left: 32px;
    font-size: 13.5px;
    color: #8a8577;
  }
  .privacy a,
  .alt a {
    color: var(--ink-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .submit {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 50px;
    padding: 0 24px;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    color: #f7f1e3;
    background: var(--forest);
    cursor: pointer;
    transition:
      background 250ms var(--ease),
      box-shadow 250ms var(--ease);
  }
  .submit:hover {
    background: var(--brand);
    box-shadow: 0 14px 30px -14px rgba(47, 122, 85, 0.7);
  }
  .submit svg {
    transition: transform 300ms var(--ease);
  }
  .submit:hover svg {
    transform: translate(2px, -2px);
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    font-size: 14px;
    color: var(--ink-mid);
  }
  .status:empty {
    display: none;
  }
  .status.warn {
    color: #9a5b1c;
  }
  .alt {
    font-size: 14px;
    color: var(--ink-mid);
  }

  /* Success state, replaces the form. */
  .sent {
    display: grid;
    justify-items: start;
    gap: 14px;
  }
  .form[hidden],
  .sent[hidden] {
    display: none;
  }
  .sent-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: #ffffff;
    background: var(--brand);
  }
  .sent h2 {
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ink-dark);
    outline: none;
  }
  .sent p {
    font-size: 17px;
    color: var(--ink-mid);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
    .side {
      position: relative;
      top: 0;
      height: auto;
      margin: 12px 12px 0;
      grid-template-rows: auto;
      border-radius: 24px;
    }
    .side-copy {
      padding: clamp(40px, 10vw, 64px) 0 28px;
    }
    .main {
      padding: 32px 16px 56px;
    }
    .row {
      grid-template-columns: 1fr;
    }
    .foot {
      flex-direction: column;
    }
    .submit {
      width: 100%;
      justify-content: center;
    }
  }
</style>
