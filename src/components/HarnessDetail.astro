---
/**
 * The detail view's picture for one Organizational Harness tile: the full
 * product view, where the tile has only a preview. Views with a `data-loop`
 * play their mechanism step by step (scripts/harness.ts) while the panel is
 * open; none of this motion runs on the tiles themselves.
 */
import HarnessArt from "./HarnessArt.astro";
import { MARK } from "@/lib/mark";

interface Props {
  name: string;
}
const { name } = Astro.props;

/** Surfaces for the fan, top to bottom, with the y of each chip's middle. */
const SURFACES = [
  { name: "Slack", y: 22 },
  { name: "Discord", y: 60 },
  { name: "Web chat", y: 98 },
  { name: "Scheduled job", y: 136 },
];
---

{
  name === "credentials" && (
    <div class="hd trace" data-loop="seq" data-steps="8" data-rest="6" data-ms="1100">
      <div class="tr-box">
        <span class="lbl">Inside the sandbox</span>
        <code class="tr-env">
          <span>GITHUB_TOKEN=</span>
          <span class="tr-tok">ghp_proxy_github_9f3a…c21e</span>
        </code>
        <code class="tr-req">POST api.github.com/…/issues</code>
        <span class="tr-revoked" data-at="7">Run ended · stand-in revoked</span>
      </div>
      <span class="tr-hop" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18">
          <path d="M3 9h11M10 5l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <div class="tr-box">
        <span class="lbl">Egress proxy</span>
        <ul class="tr-checks">
          <li data-at="1"><i />Run 4821 is still active</li>
          <li data-at="2"><i />Infinity Agent may use GitHub</li>
          <li data-at="3"><i />Host matches api.github.com</li>
          <li data-at="4"><i />Use written to the audit log</li>
        </ul>
        <code class="tr-swap" data-at="5">
          Authorization: Bearer ghp_<span class="tr-mask">••••••••••••</span>
        </code>
      </div>
      <div class="tr-out">
        <code>api.github.com</code>
        <span class="tr-res">
          <b class="ok" data-at="6">201 Created</b>
          <b class="wait">Waiting</b>
        </span>
      </div>
    </div>
  )
}

{
  name === "sandbox" && (
    <div class="hd run" data-loop="seq" data-steps="4" data-rest="1" data-ms="1800">
      <div class="run-head">
        <code>run 4821</code>
        <span class="run-state">
          <b data-only="0">Starting</b>
          <b data-only="1" class="live">Running</b>
          <b data-only="2">Finished</b>
          <b data-only="3">Sandbox removed</b>
        </span>
      </div>
      <div class="run-rail">
        <i data-at="0" />
        <i data-at="1" />
        <i data-at="2" />
        <i data-at="3" />
      </div>
      <ul class="rows">
        <li class="keep">
          <span>This workspace</span>
          <span class="swap">
            <em class="yes rw">Read &amp; write</em>
            <em class="yes" data-only="3">Kept</em>
          </span>
        </li>
        <li><span>Platform &amp; database</span><em>No access</em></li>
        <li><span>Stored keys</span><em>No access</em></li>
        <li><span>Network</span><em>Through the proxy</em></li>
      </ul>
    </div>
  )
}

{
  name === "checks" && (
    <ol class="hd log" data-loop="rotate" data-ms="2200">
      <li>
        <span class="two"><code>slack.post_message</code><small>to #support</small></span>
        <b class="v v--ok">Allowed</b>
      </li>
      <li>
        <span class="two"><code>slack.post_message</code><small>to #finance-private · not a member</small></span>
        <b class="v v--no">Denied</b>
      </li>
      <li>
        <span class="two"><code>web.fetch</code><small>169.254.169.254 · metadata address</small></span>
        <b class="v v--no">Denied</b>
      </li>
      <li>
        <span class="two"><code>github.merge_pr</code><small>changed since review</small></span>
        <b class="v v--wait">Needs review</b>
      </li>
      <li>
        <span class="two"><code>files.export_all</code><small>not registered</small></span>
        <b class="v v--no">Denied</b>
      </li>
    </ol>
  )
}

{name === "deployment" && <HarnessArt name="deployment" />}

{
  name === "access" && (
    <div class="hd chain">
      <div class="ch-row">
        <span class="node">
          <span class="av">ST</span>
          Support team
        </span>
        <span class="link">
          <em>Can use</em>
          <i />
        </span>
        <span class="node">
          <span class="av av--agent">
            <svg width="16" height="10" viewBox="0 0 40 25" aria-hidden="true"><path d={MARK} class="mark" /></svg>
          </span>
          Infinity Agent
        </span>
        <span class="link">
          <em>Can use</em>
          <i />
        </span>
        <span class="node">
          <span class="av av--key">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <circle cx="4.6" cy="7" r="2.8" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M7.4 7H13M11 7v2.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <span class="two">
            GitHub
            <code>create_issue</code>
          </span>
        </span>
      </div>
      <div class="pill-row">
        <span class="av av--grey">A</span>
        <span class="pr-who">Administrators</span>
        <span class="pr-no">Keys and content not included</span>
      </div>
      <div class="pill-row pill-row--ask">
        <span class="av av--grey">JP</span>
        <span class="pr-who">Guest from a partner workspace</span>
        <span class="ask-btn">Request access</span>
      </div>
    </div>
  )
}

{
  name === "brain" && (
    <div class="hd brain">
      <div class="br-col">
        <span class="lbl">Infinity Agent can reach</span>
        <ul class="rows">
          <li><code>handbook/</code><em>Read</em></li>
          <li><code>tickets/</code><em class="yes">Read &amp; write</em></li>
          <li><code>playbooks/</code><em class="yes">Read &amp; write</em></li>
          <li class="off">
            <code>finance/</code>
            <em>
              <svg width="11" height="12" viewBox="0 0 11 12" aria-hidden="true">
                <rect x="1" y="5" width="9" height="6.2" rx="1.6" fill="currentColor" />
                <path d="M3 5V3.6a2.5 2.5 0 0 1 5 0V5" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
              Hidden
            </em>
          </li>
        </ul>
      </div>
      <div class="br-col">
        <span class="lbl">History</span>
        <ol class="commits" data-loop="rotate" data-ms="2600">
          <li>
            <code class="sha">3f2a91c</code>
            <span class="two">Update refund policy for EU orders<small>Infinity Agent · tickets/</small></span>
            <span class="undo">Undo</span>
          </li>
          <li>
            <code class="sha">9c1e04b</code>
            <span class="two">Add Q3 escalation contacts<small>Infinity Agent · playbooks/</small></span>
            <span class="undo">Undo</span>
          </li>
          <li>
            <code class="sha">71bd5e2</code>
            <span class="two">Undo “Merge duplicate tickets”<small>Infinity Agent · tickets/</small></span>
            <span class="undo">Undo</span>
          </li>
          <li>
            <code class="sha">c08f3aa</code>
            <span class="two">Record new SLA for priority tickets<small>Infinity Agent · playbooks/</small></span>
            <span class="undo">Undo</span>
          </li>
        </ol>
      </div>
    </div>
  )
}

{
  name === "budgets" && (
    <div class="hd budget">
      <span class="lbl">This week</span>
      <ul>
        <li style="--p:0.32">
          <span>Support lead</span>
          <em>$64 of $200</em>
          <i />
        </li>
        <li style="--p:0.86" class="hot">
          <span>Analyst</span>
          <em>$171 of $200</em>
          <i />
        </li>
        <li style="--p:0.36">
          <span>Guest · partner</span>
          <em>$9 of $25</em>
          <i />
        </li>
      </ul>
      <div class="ledger">
        <code>run 4821</code>
        <span>Reserved $0.40 · settled $0.31</span>
      </div>
    </div>
  )
}

{
  name === "audit" && (
    <ol class="hd audit">
      <li>
        <span class="two"><code>connection.use</code><small>Infinity Agent · api.github.com</small></span>
        <time>14:02</time>
      </li>
      <li>
        <span class="two"><code>tool.invoke</code><small>slack.post_message</small></span>
        <time>14:02</time>
      </li>
      <li>
        <span class="two"><code>grant_request.approved</code><small>Ops leads</small></span>
        <time>13:58</time>
      </li>
      <li>
        <span class="two"><code>skill.install</code><small>release-notes · v1.3</small></span>
        <time>13:41</time>
      </li>
      <li>
        <span class="two"><code>connection.use</code><small>Infinity Agent · api.zendesk.com</small></span>
        <time>13:40</time>
      </li>
    </ol>
  )
}

{
  name === "models" && (
    <div class="hd models">
      <span class="lbl">Model for Infinity Agent</span>
      <ul>
        <li><i />Included models</li>
        <li class="on">
          <i />
          Anthropic API key<em>Your account</em>
        </li>
        <li><i />Claude subscription</li>
        <li><i />ChatGPT subscription</li>
      </ul>
    </div>
  )
}

{
  name === "skills" && (
    <div class="hd skills">
      <span class="sk-head">
        <svg width="14" height="16" viewBox="0 0 14 16" aria-hidden="true">
          <path d="M2.5 1.5h6l3 3v10h-9z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          <path d="M5 8h4M5 11h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <code>release-notes</code>
        <span class="sk-meta">Organization skill · Ops leads</span>
      </span>
      <ol class="rows">
        <li><span><b class="ver">v1.3</b>Adds the customer-facing summary</span><em class="yes">Current</em></li>
        <li><span><b class="ver">v1.2</b>Groups fixes by product area</span></li>
        <li><span><b class="ver">v1.1</b>First published</span></li>
      </ol>
    </div>
  )
}

{
  name === "surfaces" && (
    <svg class="hd fan" viewBox="0 0 320 158" aria-hidden="true">
      <g data-loop="spot" data-ms="1600">
        {SURFACES.map((s) => (
          <g class="sf">
            <path class="wire" d={`M112 ${s.y}C150 ${s.y} 150 79 184 79`} />
            <path class="flow" d={`M112 ${s.y}C150 ${s.y} 150 79 184 79`} />
            <rect class="chip" x="1" y={s.y - 14} width="111" height="28" rx="14" />
            <circle class="pip" cx="15" cy={s.y} r="3" />
            <text x="25" y={s.y + 4.5}>
              {s.name}
            </text>
          </g>
        ))}
      </g>
      <rect class="agent" x="184" y="51" width="135" height="56" rx="16" />
      <path d={MARK} transform="translate(197 71) scale(0.4)" class="mark" />
      <text class="agent-name" x="219" y="84">
        Infinity Agent
      </text>
      <text class="agent-note" x="251.5" y="128">
        Same rules
      </text>
      <text class="agent-note" x="251.5" y="144">
        Same budget
      </text>
    </svg>
  )
}

<style>
  .hd {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--moss);
  }
  .hd code {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .hd em {
    font-style: normal;
    font-weight: 500;
    color: var(--moss-3);
  }
  .hd em.yes {
    color: var(--deep);
  }
  .hd small {
    font-size: 12.5px;
    color: var(--moss-3);
  }
  .hd ul,
  .hd ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lbl {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--moss-3);
  }
  /* A name over a quieter second line. */
  .two {
    display: grid;
    min-width: 0;
    gap: 1px;
  }
  .two small {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 2px;
  }
  .rows li + li {
    border-top: 1px solid var(--ghost);
  }
  .rows li code,
  .rows li em {
    white-space: nowrap;
  }
  .mark {
    fill: none;
    stroke: #ffffff;
    stroke-width: 3.6;
    stroke-linecap: round;
  }
  /* Verdicts: green lets it through, ink stops it, ghost holds it. */
  .v {
    flex: none;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
  }
  .v--ok {
    color: var(--deep);
    background: #ffffff;
  }
  .v--no {
    color: #ffffff;
    background: var(--moss);
  }
  .v--wait {
    color: var(--moss-2);
    background: var(--ghost);
  }
  .av {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 600;
    color: var(--deep);
    background: var(--mist);
  }
  .av--agent {
    background: var(--deep);
  }
  .av--key {
    color: #ffffff;
    background: var(--moss);
  }
  .av--grey {
    color: var(--moss-2);
    background: var(--ghost);
  }

  /* Credentials: sandbox, then proxy, then the host. */
  .trace {
    display: grid;
    gap: 6px;
  }
  .tr-box {
    display: grid;
    align-content: start;
    gap: 9px;
    padding: 14px;
    border-radius: 12px;
    background: var(--wash);
  }
  .tr-env {
    display: grid;
    justify-items: start;
    gap: 4px;
  }
  .tr-tok {
    padding: 1px 5px;
    border-radius: 5px;
    color: var(--deep);
    background: var(--mist);
    transition:
      color 400ms var(--ease),
      background 400ms var(--ease);
  }
  .trace[data-step="7"] .tr-tok {
    color: var(--moss-3);
    background: var(--ghost);
    text-decoration: line-through;
  }
  .tr-req {
    color: var(--moss-2);
  }
  .tr-revoked {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--moss-2);
  }
  .tr-hop {
    display: grid;
    place-items: center;
    height: 22px;
    color: var(--moss-3);
  }
  .tr-hop svg {
    transform: rotate(90deg);
  }
  .tr-checks {
    display: grid;
    gap: 7px;
  }
  .tr-checks li {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--moss-3);
    transition: color 400ms var(--ease);
  }
  .tr-checks li.on {
    color: var(--moss);
  }
  .tr-checks i {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--moss-4);
    transition:
      background 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }
  .tr-checks li.on i {
    background: var(--deep);
    box-shadow: none;
  }
  /* The tick: two borders of a rotated box. */
  .tr-checks i::after {
    content: "";
    position: absolute;
    left: 5.5px;
    top: 3px;
    width: 4px;
    height: 7.5px;
    border: solid #ffffff;
    border-width: 0 1.6px 1.6px 0;
    transform: rotate(45deg) scale(0.4);
    opacity: 0;
    transition:
      transform 300ms var(--ease),
      opacity 300ms var(--ease);
  }
  .tr-checks li.on i::after {
    transform: rotate(45deg);
    opacity: 1;
  }
  .tr-swap {
    padding: 8px 10px;
    border-radius: 8px;
    color: #ffffff;
    background: var(--moss);
  }
  .tr-mask {
    letter-spacing: 0.05em;
  }
  .tr-out {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 12px;
    background: var(--wash);
  }
  .tr-res {
    display: grid;
  }
  .tr-res b {
    grid-area: 1 / 1;
    justify-self: end;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    transition: opacity 300ms var(--ease);
  }
  .tr-res .ok {
    color: var(--deep);
    background: var(--mist);
  }
  .tr-res .wait {
    color: var(--moss-3);
  }
  /* Steps that arrive later fade in in place, so nothing shifts. */
  .tr-revoked,
  .tr-swap,
  .tr-res .ok {
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }
  .tr-revoked.on,
  .tr-swap.on,
  .tr-res .ok.on {
    opacity: 1;
  }
  .tr-res .ok.on + .wait {
    opacity: 0;
  }

  /* Sandbox: one run's life, and what its sandbox can reach. */
  .run {
    display: grid;
    gap: 14px;
    padding: 6px 4px;
  }
  .run-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .run-state {
    display: grid;
  }
  .run-state b {
    grid-area: 1 / 1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--moss-2);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 300ms var(--ease),
      transform 300ms var(--ease);
  }
  .run-state b.on {
    opacity: 1;
    transform: none;
  }
  .run-state .live {
    color: var(--deep);
  }
  .run-state .live::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--deep);
  }
  .run-rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 5px;
  }
  .run-rail i {
    height: 4px;
    border-radius: 3px;
    background: var(--ghost);
    transition: background 500ms var(--ease);
  }
  .run-rail i.on {
    background: var(--deep);
  }
  .run .rows li {
    transition: opacity 400ms var(--ease);
  }
  /* Once the sandbox is gone only the workspace is left. */
  .run[data-step="3"] .rows li:not(.keep) {
    opacity: 0.4;
  }
  .swap {
    display: grid;
  }
  .swap em {
    grid-area: 1 / 1;
    justify-self: end;
    transition: opacity 300ms var(--ease);
  }
  .swap [data-only] {
    opacity: 0;
  }
  .swap [data-only].on {
    opacity: 1;
  }
  .run[data-step="3"] .rw {
    opacity: 0;
  }

  /* Checks: the latest tool call on top. */
  .log {
    display: grid;
    gap: 6px;
  }
  .log li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 11px;
    background: var(--wash);
  }
  .log li:first-child {
    background: var(--mist);
  }

  /* Access: who can use what, link by link. */
  .chain {
    display: grid;
    gap: 12px;
    justify-items: center;
    padding: 10px 0;
  }
  .ch-row {
    display: flex;
    align-items: center;
    margin-bottom: 6px;
  }
  .node {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 14px 6px 6px;
    border-radius: 999px;
    font-weight: 500;
    white-space: nowrap;
    background: #ffffff;
    box-shadow: inset 0 0 0 1px var(--ghost);
  }
  .node .two {
    line-height: 1.2;
  }
  .node .two code {
    font-size: 11.5px;
    font-weight: 400;
    color: var(--deep);
  }
  .link {
    position: relative;
    display: grid;
    justify-items: center;
    width: 64px;
  }
  .link em {
    position: absolute;
    bottom: 8px;
    font-size: 11.5px;
    color: var(--deep);
    white-space: nowrap;
  }
  .link i {
    position: relative;
    width: 100%;
    height: 1.6px;
    background: var(--mid);
  }
  .link i::after {
    content: "";
    position: absolute;
    right: 0;
    top: -3.2px;
    border: 4px solid transparent;
    border-left: 6px solid var(--mid);
    border-right: 0;
  }
  .pill-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    border-radius: 999px;
    background: var(--wash);
  }
  .pr-who {
    font-weight: 500;
    color: var(--moss-2);
  }
  .pr-no {
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--moss-2);
    background: var(--ghost);
  }
  .pill-row--ask {
    gap: 14px;
  }
  .ask-btn {
    padding: 5px 12px;
    border-radius: 999px;
