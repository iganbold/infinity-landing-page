---
import { site } from "@/content/site";
import Logo from "./Logo.astro";
import Arrow from "./Arrow.astro";

const path = Astro.url.pathname;
---

<header class="top frame">
  <a href="/" class="brand" aria-label={`${site.name} home`}><Logo size={24} /></a>
  <a href={site.cta.href} class="pill glass glass--rim">
    {site.cta.label}
    <Arrow />
  </a>
</header>

<nav class="dock glass glass--rim" aria-label="Primary">
  <ul>
    {
      site.nav.map((l) => (
        <li>
          <a href={l.href} aria-current={l.href === path ? "page" : undefined}>
            {l.href === path && <span class="dot" aria-hidden="true" />}
            {l.label}
            {"more" in l && <span class="plus" aria-hidden="true">+</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .top {
    position: absolute;
    inset: 26px 0 auto;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: inline-flex;
  }

  .dock {
    position: fixed;
    left: 50%;
    bottom: 22px;
    z-index: 50;
    transform: translateX(-50%);
    padding: 5px;
    border-radius: 999px;
    max-width: calc(100% - 32px);
  }
  .dock ul {
    display: flex;
    gap: 2px;
  }
  .dock a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
    transition:
      background 250ms var(--ease),
      color 250ms var(--ease);
  }
  .dock a:hover {
    color: var(--ink);
    background: rgba(238, 241, 230, 0.06);
  }
  .dock a[aria-current="page"] {
    color: var(--ink);
    background: rgba(238, 241, 230, 0.09);
    box-shadow:
      inset 0 0 0 1px rgba(238, 241, 230, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
  }
  .plus {
    color: var(--green);
    font-weight: 400;
    font-size: 15px;
  }
  @media (max-width: 420px) {
    .dock a {
      padding: 0 11px;
      font-size: 13px;
    }
  }
</style>
