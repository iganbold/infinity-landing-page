---
/**
 * The preview graphic on one Organizational Harness tile: one still picture
 * of the idea, a few words at most, in the figures' moss ink and greens. Each
 * is drawn at a fixed natural size; scripts/harness.ts shrinks it to fit its
 * tile. The detail view (HarnessDetail.astro) carries the full product view.
 */
import { MARK } from "@/lib/mark";

interface Props {
  name: string;
}
const { name } = Astro.props;

const LOCK = "M1 5h9v6.2a1.6 1.6 0 0 1-1.6 1.6H2.6A1.6 1.6 0 0 1 1 11.2zM3 5V3.6a2.5 2.5 0 0 1 5 0V5";

/** Access: the levels a person can hold, lowest first (the same words as the detail view). */
const LEVELS = [
  { name: "Off", now: "" },
  { name: "Can view", now: "can view now" },
  { name: "Can use", now: "can use it now" },
  { name: "Can edit", now: "can edit now" },
  { name: "Can manage", now: "can manage it now" },
];

/**
 * Company brain: a brain at the centre and three layers of knowledge round
 * it, branching outward: six nodes, each forking into two, then two again.
 * A few branches are lit, what one agent draws on. The outer layer is dashed:
 * the brain's boundary.
 */
const BW = 440;
const BH = 300;
const [CX, CY] = [BW / 2, BH / 2];
const DISC = 31;
const LAYERS = [
  { rx: 80, ry: 56, r: 4 },
  { rx: 136, ry: 94, r: 3.4 },
  { rx: 190, ry: 128, r: 3 },
];
type Node = { a: number; x: number; y: number; r: number; parent: number; lit: boolean };
const at = (k: number, a: number) => [CX + LAYERS[k].rx * Math.cos(a), CY + LAYERS[k].ry * Math.sin(a)];
const node = (k: number, a: number, parent: number): Node => {
  const [x, y] = at(k, a);
  return { a, x, y, r: LAYERS[k].r, parent, lit: false };
};
const STEP = (Math.PI * 2) / 6;
const nodes: Node[][] = [Array.from({ length: 6 }, (_, i) => node(0, (i + 0.5) * STEP - Math.PI / 2, -1))];
for (let k = 1; k < LAYERS.length; k++) {
  const fork = STEP / 2 ** (k + 1);
  nodes.push(nodes[k - 1].flatMap((p, j) => [node(k, p.a - fork, j), node(k, p.a + fork, j)]));
}
// Light a few outer nodes and everything between them and the brain.
for (const i of [2, 3, 12, 19]) {
  for (let k = 2, n = nodes[2][i]; k >= 0; n = nodes[--k]?.[n.parent]) if (n) n.lit = true;
}
const f = (v: number) => v.toFixed(1);
/** Each branch leaves its parent heading outward, then bends into its child. */
const links = nodes.flatMap((layer, k) =>
  layer.map((n) => {
    if (k === 0) {
      const d = Math.hypot(n.x - CX, n.y - CY);
      return { d: `M${f(CX + ((n.x - CX) / d) * DISC)} ${f(CY + ((n.y - CY) / d) * DISC)}L${f(n.x)} ${f(n.y)}`, lit: n.lit };
    }
    const p = nodes[k - 1][n.parent];
    const mid = { rx: (LAYERS[k - 1].rx + LAYERS[k].rx) / 2, ry: (LAYERS[k - 1].ry + LAYERS[k].ry) / 2 };
    const [qx, qy] = [CX + mid.rx * Math.cos(p.a), CY + mid.ry * Math.sin(p.a)];
    return { d: `M${f(p.x)} ${f(p.y)}Q${f(qx)} ${f(qy)} ${f(n.x)} ${f(n.y)}`, lit: n.lit };
  }),
);
/** The brain seen from above: the left half, mirrored for the right. */
const HALF = [
  "M-1.5 -17C-6 -21 -14 -20.5 -17 -15.5C-22 -14 -24.5 -8.5 -22.5 -4C-25 0 -24 6.5 -19.5 9C-19 15 -12.5 19.5 -6.5 17.5C-4.5 19 -2 18.5 -1.5 17Z",
  "M-1.5 -9C-5 -11 -8.5 -8.5 -8 -5",
  "M-17 -15.5C-15 -12 -16 -9 -13 -7.5",
  "M-22.5 -4C-18 -4.5 -15.5 -1.5 -12.5 -2",
  "M-1.5 3C-5 1.5 -9 3.5 -9.5 7",
  "M-19.5 9C-16 7.5 -13 9 -12.5 12.5",
];
const mirror = (d: string) => d.replace(/(-?\d*\.?\d+) (-?\d*\.?\d+)/g, (_, x, y) => `${-x} ${y}`);
const BRAIN = [...HALF, ...HALF.map(mirror)];
---

{
  name === "credentials" && (
    <div class="ha cred">
      <span class="cr-chip">
        <small>Agent holds</small>
        <code>ghp_proxy_…</code>
      </span>
      <span class="cr-lock">
        <svg width="12" height="14" viewBox="0 0 11 13" aria-hidden="true">
          <path d={LOCK} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="cr-chip cr-chip--out">
        <small>API receives</small>
        <code>ghp_••••••</code>
      </span>
    </div>
  )
}

{
  name === "sandbox" && (
    <div class="ha sbx">
      <span class="sbx-box">
        <span class="sys">
          <svg width="22" height="14" viewBox="0 0 40 25" aria-hidden="true"><path d={MARK} class="mark" /></svg>
        </span>
      </span>
      <ul class="sbx-out">
        {["Platform", "Database", "Keys"].map((o) => (
          <li>
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <circle cx="7" cy="7" r="6.4" fill="#fff" />
              <path d="M4.8 4.8l4.4 4.4m0-4.4l-4.4 4.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
            {o}
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  name === "checks" && (
    <ul class="ha verdicts">
      <li><code>post_message</code><b class="v v--ok">Allowed</b></li>
      <li><code>create_issue</code><b class="v v--ok">Allowed</b></li>
      <li><code>web.fetch</code><b class="v v--no">Denied</b></li>
      <li><code>merge_pr</code><b class="v v--wait">Review</b></li>
      <li><code>export_all</code><b class="v v--no">Denied</b></li>
    </ul>
  )
}

{
  name === "deployment" && (
    <div class="ha dep">
      <span class="dep-edge">Cloudflare</span>
      <svg class="dep-arrow" width="22" height="12" viewBox="0 0 22 12" aria-hidden="true">
        <path d="M1 6h19M15 1.5L20 6l-5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="dep-wall">
        {["Agents", "Data", "Keys"].map((c) => <span><i />{c}</span>)}
      </span>
    </div>
  )
}

{
  name === "access" && (
    <div class="ha lvl" data-loop="seq" data-steps={LEVELS.length} data-rest="2" data-ms="1700">
      <span class="lvl-who">
        {LEVELS.map((l, k) => k > 0 && <span data-only={k}>Jessie {l.now}</span>)}
      </span>
      <span class="lvl-name">
        {LEVELS.map((l, k) => <span class:list={{ "lvl-off": k === 0 }} data-only={k}>{l.name}</span>)}
      </span>
      <span class="lvl-pill" data-at="1">
        {LEVELS.slice(1).map((_, k) => <i data-at={k + 1} />)}
      </span>
    </div>
  )
}

{
  name === "brain" && (
    <svg class="ha brn" width={BW} height={BH} viewBox={`0 0 ${BW} ${BH}`} aria-hidden="true">
      {LAYERS.map((l, k) => (
        <ellipse class:list={["brn-layer", { "brn-layer--edge": k === LAYERS.length - 1 }]} cx={CX} cy={CY} rx={l.rx} ry={l.ry} />
      ))}
      {links.filter((l) => !l.lit).map((l) => <path class="brn-link" d={l.d} />)}
      {links.filter((l) => l.lit).map((l) => <path class="brn-link brn-link--lit" d={l.d} />)}
      {nodes.flat().map((n) => <circle class:list={["brn-node", { "brn-node--lit": n.lit }]} cx={f(n.x)} cy={f(n.y)} r={n.r} />)}
      <circle class="brn-halo" cx={CX} cy={CY} r={DISC + 7} />
      <circle class="brn-disc" cx={CX} cy={CY} r={DISC} />
      <g class="brn-glyph" transform={`translate(${CX} ${CY})`}>
        {BRAIN.map((d) => <path d={d} />)}
      </g>
    </svg>
  )
}

{
  name === "budgets" && (
    <ul class="ha budget">
      <li style="--p:0.32"><span>Support lead</span><i /></li>
      <li style="--p:0.86" class="hot"><span>Analyst</span><i /></li>
      <li style="--p:0.36"><span>Guest</span><i /></li>
    </ul>
  )
}

{
  name === "audit" && (
    <ul class="ha audit">
      <li><code>connection.use</code><time>14:02</time></li>
      <li><code>tool.invoke</code><time>14:02</time></li>
      <li><code>grant_request</code><time>13:58</time></li>
    </ul>
  )
}

{
  name === "models" && (
    <ul class="ha models">
      <li><i />Included models</li>
      <li class="on"><i />Anthropic API key</li>
      <li><i />ChatGPT subscription</li>
    </ul>
  )
}

{
  name === "skills" && (
    <div class="ha skills">
      <span class="sk-card sk-card--back2" />
      <span class="sk-card sk-card--back1" />
      <span class="sk-card">
        <svg width="14" height="16" viewBox="0 0 14 16" aria-hidden="true">
          <path d="M2.5 1.5h6l3 3v10h-9z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          <path d="M5 8h4M5 11h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <code>release-notes</code>
        <b class="ver">v1.3</b>
      </span>
    </div>
  )
}

{
  name === "surfaces" && (
    <div class="ha srf">
      <ul class="srf-in">
        {["Slack", "Discord", "Web chat", "Scheduled job"].map((s) => <li><i />{s}</li>)}
      </ul>
      <svg class="srf-arrow" width="30" height="12" viewBox="0 0 30 12" aria-hidden="true">
        <path d="M1 6h27M23 1.5L28 6l-5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="srf-agent">
        <svg width="18" height="12" viewBox="0 0 40 25" aria-hidden="true"><path d={MARK} class="mark" /></svg>
        Infinity Agent
      </span>
    </div>
  )
}

<style>
  /* Every preview has a fixed natural size; nothing wraps. */
  .ha {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--moss);
  }
  .ha code {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0;
  }
  .ha em {
    font-style: normal;
    font-weight: 500;
    color: var(--moss-3);
  }
  .ha em.yes {
    color: var(--deep);
  }
  .mark {
    fill: none;
    stroke: #ffffff;
    stroke-width: 3.6;
    stroke-linecap: round;
  }

  /* Credentials: what the agent holds, what the API gets. */
  .cred {
    display: flex;
    align-items: center;
    padding: 14px;
  }
  .cr-chip {
    display: grid;
    gap: 4px;
    padding: 11px 14px;
    border-radius: 13px;
    background: var(--wash);
  }
  .cr-chip small {
    font-size: 12px;
    font-weight: 500;
    color: var(--moss-3);
  }
  .cr-chip code {
    color: var(--deep);
  }
  .cr-chip--out {
    background: var(--moss);
  }
  .cr-chip--out small {
    color: rgba(255, 255, 255, 0.6);
  }
  .cr-chip--out code {
    color: #ffffff;
    letter-spacing: 0.04em;
  }
  /* The proxy between them: a lock on the line. */
  .cr-lock {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 34px;
    color: #ffffff;
  }
  .cr-lock::before {
    content: "";
    position: absolute;
    left: 4px;
    right: 4px;
    top: 50%;
    height: 1.6px;
    background: var(--mid);
  }
  .cr-lock svg {
    position: relative;
    box-sizing: content-box;
    padding: 9px 10px 9px 11px;
    border-radius: 50%;
    background: var(--deep);
  }

  /* Sandbox: a dashed boundary, cut off from what sits outside it. */
  .sbx {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .sbx-box {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border: 1.6px dashed var(--deep);
    border-radius: 18px;
    background: #ffffff;
  }
  .sys {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--deep);
  }
  .sbx-out {
    display: grid;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sbx-out li {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 24px;
    padding: 0 11px 0 5px;
    border-radius: 999px;
    font-weight: 500;
    color: var(--moss-2);
    background: var(--ghost);
  }
  .sbx-out svg {
    color: var(--moss-3);
  }

  /* Deployment: one way in, through one wall. */
  .dep {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dep-edge {
    padding: 6px 11px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: #ffffff;
    background: var(--moss);
  }
  .dep-arrow {
    color: var(--moss);
  }
  .dep-wall {
    display: grid;
    gap: 4px;
    padding: 8px;
    border: 2px solid var(--deep);
    border-radius: 15px;
    background: #ffffff;
  }
  .dep-wall span {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 92px;
    height: 22px;
    padding: 0 10px;
    border-radius: 999px;
    font-weight: 500;
    background: var(--wash);
  }
  .dep-wall i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--deep);
  }

  /* Checks: tool calls on the green, each with its verdict. */
  .verdicts {
    display: grid;
    gap: 7px;
    width: 200px;
  }
  .verdicts li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 9px 8px 12px;
    border-radius: 11px;
    background: #ffffff;
  }
  .v {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
  }
  .v--ok {
    color: var(--deep);
    background: var(--mist);
  }
  .v--no {
    color: #ffffff;
    background: var(--moss);
  }
  .v--wait {
    color: var(--moss-2);
    background: var(--ghost);
  }

  /* Access: one person's level, stepping up from Off to Can manage. The pill
     opens from a single dot, and one more dot fills green at each level. */
  .lvl {
    display: grid;
    grid-template-columns: 96px auto;
    grid-template-rows: auto auto;
    align-items: center;
    gap: 10px 16px;
  }
  /* Each stack holds every state in one cell; only the current one shows. */
  .lvl-who,
  .lvl-name {
    display: grid;
  }
  .lvl-who > span,
  .lvl-name > span {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 360ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .lvl-who > span.on,
  .lvl-name > span.on {
    opacity: 1;
    transform: none;
  }
  .lvl-who {
    grid-area: 1 / 2;
    min-height: 1.3em;
    font-weight: 600;
    color: var(--deep);
  }
  .lvl-name {
    grid-area: 2 / 1;
    justify-items: end;
    font-size: 14px;
    font-weight: 500;
    color: var(--moss);
  }
  .lvl-name .lvl-off {
    color: var(--moss-3);
  }
  .lvl-pill {
    grid-area: 2 / 2;
    display: flex;
    align-items: center;
    gap: 16px;
    width: 48px;
    height: 48px;
    /* Centres the first dot while the pill is closed. */
    padding-left: 18.5px;
    border-radius: 999px;
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      inset 0 0 0 1px var(--ghost),
      0 6px 16px -10px rgba(18, 40, 26, 0.35);
    transition: width 640ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .lvl-pill.on {
    width: 144px;
  }
  .lvl-pill i {
    flex: none;
    border-radius: 50%;
    background: var(--ghost);
    transition:
      background 360ms ease,
      opacity 360ms ease;
  }
  /* Closed, the pill shows only its first dot. */
  .lvl-pill:not(.on) i + i {
    opacity: 0;
  }
  .lvl-pill i:nth-child(1) { width: 11px; height: 11px; }
  .lvl-pill i:nth-child(2) { width: 14px; height: 14px; }
  .lvl-pill i:nth-child(3) { width: 17px; height: 17px; }
  .lvl-pill i:nth-child(4) { width: 21px; height: 21px; }
  .lvl-pill i.on {
    background: var(--mid);
  }

  /* Brain: hairlines only, so every stroke stays 1px however far the tile zooms it down. */
  .brn {
    display: block;
    overflow: visible;
  }
  .brn :is(ellipse, line, circle, path) {
    vector-effect: non-scaling-stroke;
  }
  .brn-layer {
    fill: none;
    stroke: var(--moss-4);
    stroke-width: 1;
  }
  .brn-layer--edge {
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }
  .brn-link {
    fill: none;
    stroke: var(--moss-4);
    stroke-width: 1;
  }
  .brn-link--lit {
    stroke: var(--mid);
    stroke-width: 1.25;
  }
  .brn-node {
    fill: #ffffff;
    stroke: var(--moss-3);
    stroke-width: 1;
  }
  .brn-node--lit {
    fill: var(--deep);
    stroke: var(--deep);
  }
  .brn-halo {
    fill: none;
    stroke: var(--pale);
    stroke-width: 1;
  }
  .brn-disc {
    fill: #ffffff;
    stroke: var(--deep);
    stroke-width: 1.25;
  }
  .brn-glyph {
    fill: none;
    stroke: var(--deep);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Budgets: an allowance each, spent so far. */
  .budget {
    display: grid;
    gap: 11px;
    width: 180px;
  }
  .budget li {
    display: grid;
    gap: 5px;
    font-weight: 500;
  }
  .budget li i {
    position: relative;
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
    background: var(--ghost);
  }
  .budget li i::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--deep);
    transform: scaleX(var(--p));
    transform-origin: left center;
  }
  .budget li.hot i::after {
    background: var(--moss);
  }

  /* Audit: three lines of the log. */
  .audit {
    display: grid;
    width: 180px;
  }
  .audit li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 0;
  }
  .audit li + li {
    border-top: 1px solid var(--ghost);
  }
  .audit time {
    font-size: 12px;
    color: var(--moss-3);
    font-variant-numeric: tabular-nums;
  }

  /* Models: the agent's pick. */
  .models {
    display: grid;
    gap: 3px;
    width: 186px;
  }
  .models li {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 10px;
    border-radius: 10px;
    font-weight: 500;
    color: var(--moss-2);
  }
  .models li.on {
    color: var(--moss);
    background: #ffffff;
    box-shadow: inset 0 0 0 1px var(--pale);
  }
  .models i {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--moss-4);
  }
  .models li.on i {
    background: #ffffff;
    box-shadow: inset 0 0 0 4px var(--deep);
  }

  /* Skills: a published package on its stack of earlier versions. */
  .skills {
    display: grid;
    width: 196px;
    padding-top: 18px;
  }
  .sk-card {
    position: relative;
    z-index: 2;
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    gap: 9px;
    height: 48px;
    padding: 0 12px 0 14px;
    border-radius: 13px;
    background: #ffffff;
    box-shadow: 0 10px 24px -16px rgba(18, 40, 26, 0.45);
  }
  .sk-card--back1 {
    z-index: 1;
    transform: translateY(-9px) scale(0.94);
    opacity: 0.75;
    box-shadow: inset 0 0 0 1px var(--ghost);
  }
  .sk-card--back2 {
    z-index: 0;
    transform: translateY(-18px) scale(0.88);
    opacity: 0.5;
    box-shadow: inset 0 0 0 1px var(--ghost);
  }
  .ver {
    margin-left: auto;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--deep);
    background: var(--mist);
  }

  /* Surfaces: every surface into one agent. */
  .srf {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .srf-in {
    display: grid;
    grid-template-columns: auto auto;
