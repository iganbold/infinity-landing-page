---
import { whoWeAre as w } from "@/content/site";

// Split on *highlight*. Punctuation right after a highlight stays glued to it
// (nowrap), so a line never starts with ", building".
const segs = w.title.split("*").map((text, i) => ({ text, hl: i % 2 === 1 }));
const parts = segs.map((seg, i) => {
  if (seg.hl) {
    const m = segs[i + 1]?.text.match(/^[,.;:!?]+/);
    // Two balanced halves, each unbreakable, so a wrapped box hugs its text.
    const words = seg.text.split(" ");
    let cut = 1;
    let best = Infinity;
    for (let k = 1; k < words.length; k++) {
      const d = Math.abs(words.slice(0, k).join(" ").length - words.slice(k).join(" ").length);
      if (d < best) [best, cut] = [d, k];
    }
    const halves = words.length > 1 ? [words.slice(0, cut).join(" "), words.slice(cut).join(" ")] : [seg.text];
    return { ...seg, halves, tail: m ? m[0] : "" };
  }
  const prevHl = segs[i - 1]?.hl;
  const m = prevHl ? seg.text.match(/^[,.;:!?]+/) : null;
  return { ...seg, text: m ? seg.text.slice(m[0].length) : seg.text, halves: [], tail: "" };
});
---

<section class="who" id="who-we-are" aria-labelledby="who-title">
  <div class="card frame">
    <h2 id="who-title" class="title" data-reveal>
      {
        parts.map((p) =>
          p.hl ? (
            <span class="hl-wrap">
              <mark class="hl">
                {p.halves.map((h, k) => (k ? <> <span class="half">{h}</span></> : <span class="half">{h}</span>))}
              </mark>
              {p.tail}
            </span>
          ) : (
            p.text
          ),
        )
      }
    </h2>

    <a href={w.cta.href} class="cta" data-reveal style="--d:1">
      {w.cta.label}
      <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"
        ><path d="M4 12L12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
        ></path></svg
      >
    </a>

    <hr class="rule" data-reveal style="--d:2" />

    <!-- Chatbots, Agents, Systems as a comparison: one column each, the same
         rows across. Each column is a list item holding its own labelled
         values (so it reads on its own); the label column on the left is only
         visual. The last column is the product, so it's filled. -->
    <div class="compare-wrap">
      <div class="labels" aria-hidden="true">
        <span class="cell cell--head"></span>
        {Object.values(w.compareRows).map((label) => <span class="cell label">{label}</span>)}
      </div>
      <ol class="compare" aria-label="Chatbots, agents, and Systems compared">
        {
          w.compare.map((c, i) => (
            <li class:list={["step", { "step--on": i === w.compare.length - 1 }]} data-reveal style={`--d:${3 + i}`}>
              {i === w.compare.length - 1 && (
                <>
                  <span class="glow" aria-hidden="true" />
                  <span class="glow-ring" aria-hidden="true" />
                </>
              )}
              <span class="cell cell--head step-head">{c.name}</span>
              <dl class="rows">
                <div class="cell">
                  <dt class="row-label">{w.compareRows.title}</dt>
                  <dd class="step-title">{c.title}</dd>
                </div>
                <div class="cell">
                  <dt class="row-label">{w.compareRows.body}</dt>
                  <dd class="step-body">{c.body}</dd>
                </div>
                <div class="cell">
                  <dt class="row-label">{w.compareRows.span}</dt>
                  <dd class="step-span">{c.span}</dd>
                </div>
                <div class="cell">
                  <dt class="row-label">{w.compareRows.level}</dt>
                  <dd class="meter" role="img" aria-label={`${c.level} of ${w.compare.length}`}>
                    {w.compare.map((_, k) => <i class:list={{ on: k < c.level }} />)}
                  </dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .who {
    position: relative;
    z-index: 1;
    padding: clamp(48px, 8vh, 96px) 0 clamp(40px, 6vh, 72px);
    /* Transparent: the page's green-to-ivory blend shows through. */
    background: transparent;
    --ink-dark: #16150f;
  }

  .card {
    position: relative;
    display: grid;
    padding: clamp(32px, 6vw, 88px);
    border-radius: 32px;
    overflow: hidden;
    color: var(--ink-dark);
    /* Soft sage panel on the white page, warm light at the top. */
    background:
      radial-gradient(70% 55% at 50% 0%, rgba(255, 236, 200, 0.55), transparent 70%),
      radial-gradient(55% 55% at 100% 100%, rgba(170, 220, 200, 0.4), transparent 70%),
      linear-gradient(180deg, #f2f4ec 0%, #e9eee3 55%, #e1e8dc 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 0 0 1px rgba(40, 70, 50, 0.06),
      0 24px 60px -36px rgba(30, 50, 35, 0.35);
  }

  .title {
    max-width: 30ch;
    font-size: clamp(30px, 4.2vw, 64px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--ink-dark);
  }

  /* Brand highlight: one box (not per-line fragments), so the background and
     its dot grid are continuous. Stays on one line where it fits; on narrow
     screens it wraps inside the same box. */
  .hl {
    display: inline-block;
    padding: 0.04em 0.22em 0.1em;
    margin: 0.04em -0.04em;
    border-radius: 0.18em;
    color: #ffffff;
    /* Solid brand green with a fine dot texture inside, drifting slowly. */
    background-color: #2f7a55;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.2) 1px, transparent 1.4px);
    background-size: 7px 7px;
    animation: hl-dots 12s linear infinite;
  }

  .hl-wrap {
    white-space: nowrap;
  }
  /* The box may wrap between its two halves on narrow screens. */
  .hl-wrap .hl {
    white-space: normal;
  }
  .half {
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    /* Shrink the box to the longer half instead of the full column width. */
    .hl {
      width: min-content;
    }
  }

  @keyframes hl-dots {
    to {
      background-position: 70px 0;
    }
  }

  .rule {
    width: 100%;
    height: 1px;
    margin: clamp(40px, 6vw, 72px) 0 clamp(28px, 4vw, 44px);
    border: 0;
    background: linear-gradient(90deg, rgba(22, 21, 15, 0.22), rgba(22, 21, 15, 0.08) 70%, transparent);
  }

  .cta {
    justify-self: start;
    margin-top: clamp(28px, 3.5vw, 44px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    color: #f7f1e3;
    background: var(--ink-dark);
    transition:
      background 250ms var(--ease),
      transform 250ms var(--ease);
  }
  .cta:hover {
    background: #1f3a2f;
  }
  .cta svg {
    transition: transform 300ms var(--ease);
  }
  .cta:hover svg {
    transform: translate(2px, -2px);
  }

  /* ------------------------------------------------ comparison */

  /* One white table: a label column and three product columns. Every column
     spans the same five rows (subgrid), so values line up across. */
  .compare-wrap {
    display: grid;
    grid-template-columns: minmax(120px, 0.55fr) repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(5, auto);
    border-radius: 22px;
    background: #ffffff;
    box-shadow:
      inset 0 0 0 1px rgba(22, 21, 15, 0.06),
      0 18px 40px -30px rgba(30, 50, 35, 0.3);
  }
  .labels,
  .compare,
  .step,
  .rows {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / -1;
  }
  .compare {
    grid-column: 2 / -1;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows {
    grid-row: 2 / -1;
    margin: 0;
  }
  .cell dd {
    margin: 0;
  }
  .cell {
    display: grid;
    align-content: center;
    padding: 16px clamp(18px, 2vw, 28px);
    border-top: 1px solid rgba(22, 21, 15, 0.07);
  }
  .cell--head {
    align-content: end;
    padding-top: clamp(22px, 2.4vw, 30px);
    padding-bottom: 14px;
    border-top: 0;
  }
  .label {
    font-size: 13px;
    font-weight: 500;
    color: #8a978d;
  }
  .step {
    position: relative;
    isolation: isolate;
  }
  /* A hairline between the product columns. */
  .step:not(:first-child)::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    width: 1px;
    background: rgba(22, 21, 15, 0.07);
  }
  /* The labels live in the left column on wide screens. */
  .row-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .step-head {
    font-size: 14px;
    font-weight: 500;
    color: #57544a;
  }
  .step-title {
    font-size: clamp(20px, 1.8vw, 28px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--ink-dark);
  }
  .step-body {
    font-size: 15px;
    line-height: 1.5;
    color: #57544a;
  }
  .step-span {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-dark);
  }
  /* Ownership: three segments, filled up to the level. */
  .meter {
    display: flex;
    gap: 5px;
  }
  .meter i {
    width: 22px;
    height: 6px;
    border-radius: 3px;
    background: rgba(22, 21, 15, 0.1);
  }
  .meter i.on {
    background: #2f7a55;
  }

  /* Systems: the brand column, standing a little proud of the table like a
     recommended plan. Same green and dot texture as the highlight. */
  .step--on {
    margin: -10px 0;
    padding: 10px 0;
    border-radius: 20px;
    overflow: hidden;
    background-color: #2f7a55;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.16) 1px, transparent 1.4px);
    background-size: 7px 7px;
    animation: hl-dots 12s linear infinite;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 18px 40px -18px rgba(31, 90, 60, 0.6);
  }
  .step--on::before {
    display: none;
  }
  .step--on .cell {
    border-top-color: rgba(255, 255, 255, 0.16);
  }
  .step--on .cell--head {
    border-top: 0;
  }
  .step--on .step-span,
  .step--on .step-title {
    color: #ffffff;
  }
  .step--on .meter i {
    background: rgba(255, 255, 255, 0.22);
  }
  .step--on .meter i.on {
    background: #ffffff;
  }
  .step--on .step-head,
  .step--on .step-body {
    color: rgba(255, 255, 255, 0.82);
  }
  /* Siri-style inner glow, as on the booking page: a rotating conic band along
     the edges, blurred inward; the card's overflow keeps it inside. */
  @property --glow-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
  .glow,
  .glow-ring {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
  }
  .glow::before,
  .glow-ring::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(from var(--glow-angle), #ffcf7a, #d6f58a, #4fe3b0, #6cc4ff, #4fe3b0, #d6f58a, #ffcf7a);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: glow-spin 9s linear infinite;
  }
  .glow {
    filter: blur(14px) saturate(1.3);
  }
  .glow::before {
    padding: 10px;
  }
  .glow-ring {
    filter: blur(2px);
    opacity: 0.85;
  }
  .glow-ring::before {
    padding: 2px;
  }
  @keyframes glow-spin {
    to {
      --glow-angle: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .glow::before,
    .glow-ring::before {
      animation: none;
    }
  }

  .step--on .step-title {
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .card {
      border-radius: 24px;
    }
    /* Phones: the columns stack as cards, each with its own row labels. */
    .compare-wrap {
      display: block;
      background: none;
      box-shadow: none;
    }
    .labels {
      display: none;
    }
    .compare,
    .step,
    .rows {
      display: grid;
      grid-row: auto;
      grid-template-rows: none;
      grid-template-columns: none;
    }
    .compare {
      gap: 12px;
    }
    .step {
      border-radius: 20px;
      background: #ffffff;
      box-shadow: inset 0 0 0 1px rgba(22, 21, 15, 0.06);
    }
    .step:not(:first-child)::before {
      display: none;
    }
    .step--on {
      margin: 0;
      padding: 0;
      background-color: #2f7a55;
    }
    .cell {
      grid-template-columns: 7.5rem 1fr;
      align-items: center;
      gap: 12px;
      padding: 14px 20px;
    }
    .cell--head {
      padding-top: 20px;
    }
    .row-label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      font-size: 13px;
      font-weight: 500;
      color: #8a978d;
    }
    .step--on .row-label {
      color: rgba(255, 255, 255, 0.7);
    }
  }
</style>
