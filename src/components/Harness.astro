---
import { harness as h } from "@/content/site";
import HarnessArt from "./HarnessArt.astro";
import HarnessDetail from "./HarnessDetail.astro";

const pad = (n: number) => String(n).padStart(2, "0");

/** A forest photo as a background, WebP first (same backdrops as How it works). */
const photo = (n: string) =>
  `background-image: image-set(url(/primitives/${n}.webp) type("image/webp"), url(/primitives/${n}.jpg) type("image/jpeg"))`;
const BACKDROPS = ["01-forest-floor", "02-woodland", "03-vista", "04-panorama"];

/** Tiles whose graphic sits on a photo, framed like the How it works cards. */
const PHOTO: Partial<Record<string, string>> = { credentials: "01-forest-floor", brain: "04-panorama" };
/** The one tile in the brand green. */
const GREEN = "checks";
---

<section class="harness" id="security" aria-labelledby="harness-title">
  <div class="frame">
    <header class="head">
      <h2 id="harness-title" class="title" data-reveal>{h.title}</h2>
      <span class="title-rule" aria-hidden="true" data-reveal style="--d:1"></span>
      <p class="intro" data-reveal style="--d:2">{h.intro}</p>
    </header>

    <!-- Bento: big 2×2, wide 2×1, tall 1×2 and small 1×1 tiles, packed densely.
         Each tile is a preview: one still graphic and a short label. The
         label's button opens the detail view; its hit area covers the tile.
         Rows take their height from the viewport, so on a desktop the whole
         grid fits on one screen; each graphic shrinks to fit its tile. -->
    <ol class="bento">
      {
        h.items.map((item, i) => (
          <li class:list={["card", `card--${item.size}`, `tile-${item.key}`]} data-tile data-reveal style={`--d:${i % 4}`}>
            <div class:list={["art", { "art--photo": PHOTO[item.key], "art--green": item.key === GREEN }]} aria-hidden="true">
              {PHOTO[item.key] && <span class="art-bg" style={photo(PHOTO[item.key]!)} />}
              <div class="fit" data-fit>
                {PHOTO[item.key] ? (
                  <div class="rim">
                    <div class="paper">
                      <HarnessArt name={item.key} />
                    </div>
                  </div>
                ) : (
                  <HarnessArt name={item.key} />
                )}
              </div>
            </div>
            <div class="cap">
              <h3 class="cap-title">
                <button type="button" class="open" data-open={item.key} aria-haspopup="dialog">
                  {item.label}
                </button>
              </h3>
              <span class="plus" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 14 14">
                  <path d="M7 2v10M2 7h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Detail view: one dialog, one panel per tile; previous and next step
       through them in tile order. -->
  <dialog class="sheet" data-sheet aria-labelledby={`hx-t-${h.items[0].key}`}>
    <div class="sheet-in">
      <button type="button" class="close" data-sheet-close aria-label={h.dialog.close}>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M3 3l8 8M11 3l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      <div class="sheet-scroll" data-sheet-scroll>
        {
          h.items.map((item, i) => (
            <article class="panel" data-panel={item.key} data-title={item.title} hidden={i !== 0}>
              <div class="panel-text">
                <span class="n mono">
                  {pad(i + 1)} / {pad(h.items.length)}
                </span>
                <h3 id={`hx-t-${item.key}`} class="panel-title">
                  {item.title}
                </h3>
                <p class="panel-body">{item.body}</p>
                <ul class="points">
                  {item.points.map((p) => (
                    <li>
                      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                        <circle cx="8" cy="8" r="8" fill="#2f7a55" />
                        <path d="M4.8 8.2l2.1 2.1 4.3-4.6" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="panel-visual" aria-hidden="true" data-hold>
                <span class="art-bg" style={photo(BACKDROPS[i % BACKDROPS.length])} />
                <div class="rim">
                  <div class="paper paper--detail">
                    <HarnessDetail name={item.key} />
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <nav class="sheet-foot" aria-label="More of the harness">
        <button type="button" class="step" data-sheet-prev>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M13 8H3M7 4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="step-text">
            <small>{h.dialog.prev}</small>
            <b data-sheet-prev-name></b>
          </span>
        </button>
        <button type="button" class="step step--next" data-sheet-next>
          <span class="step-text">
            <small>{h.dialog.next}</small>
            <b data-sheet-next-name></b>
          </span>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </nav>
    </div>
  </dialog>
</section>

<script>
  import { mountHarness } from "@/scripts/harness";

  const section = document.querySelector<HTMLElement>("#security");
  if (section) mountHarness(section);
</script>

<style>
  .harness {
    position: relative;
    z-index: 1;
    /* How it works above already leaves its own room at the bottom. */
    padding: 0 0 clamp(120px, 16vh, 180px);
    --ink-dark: #16150f;
    --ink-mid: #57544a;
    /* The figures' moss ink and greens (scripts/figures.ts). */
    --moss: #17201a;
    --moss-2: #4b5a4f;
    --moss-3: #8a978d;
    --moss-4: #c2cbc3;
    --ghost: #e3e8e2;
    --wash: #f3f6f2;
    --deep: #2f7a55;
    --mid: #5fa37a;
    --pale: #cfe3c6;
    --mist: #e7f1e2;
  }

  /* ------------------------------------------------ head */

  /* Centred, like How it works: the title, the rule under it, then the intro. */
  .head {
    display: grid;
    justify-items: center;
    gap: 22px;
    margin-bottom: clamp(32px, 4vw, 56px);
    text-align: center;
  }
  .title {
    font-size: clamp(34px, 5vw, 76px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink-dark);
  }
  .title-rule {
    width: 72px;
    height: 4px;
    border-radius: 4px;
    background: var(--deep);
  }
  .intro {
    max-width: 46ch;
    text-wrap: balance;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.55;
    color: var(--ink-mid);
  }

  /* ------------------------------------------------ bento */

  /* Desktop: five columns, four rows, sized to the screen. */
  .bento {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: clamp(150px, calc((100svh - 180px) / 4), 200px);
    grid-auto-flow: row dense;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card--big {
    grid-column: span 2;
    grid-row: span 2;
  }
  .card--wide {
    grid-column: span 2;
  }
  .card--tall {
    grid-row: span 2;
  }

  /* Same white sheet as the comparison table above: the graphic inset at
     the top, the title under it. */
  .card {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
      inset 0 0 0 1px rgba(22, 21, 15, 0.06),
      0 18px 40px -30px rgba(30, 50, 35, 0.3);
    transition:
      transform 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 0 1px rgba(22, 21, 15, 0.08),
      0 26px 50px -30px rgba(30, 50, 35, 0.45);
  }
  .card:active {
    transform: translateY(-1px) scale(0.995);
  }
  .card:has(.open:focus-visible) {
    outline: 2px solid var(--deep);
    outline-offset: 3px;
  }

  .art {
    position: relative;
    display: grid;
    place-items: center;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    min-height: 0;
    margin: 6px 6px 0;
    padding: 12px;
    border-radius: 15px;
    overflow: hidden;
    isolation: isolate;
    background: var(--wash);
  }
  /* The preview at its natural size; scripts/harness.ts zooms it down to fit. */
  .fit {
    width: max-content;
  }
  /* The green tile, with the dot texture of the Systems column. */
  .art--green {
    padding: 4px;
    background-color: var(--deep);
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.16) 1px, transparent 1.4px);
    background-size: 7px 7px;
  }
  /* Photo tiles: the forest behind a frosted rim and a paper sheet. */
  .art--photo {
    background: #1a3326;
  }
  .art-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: center 62% / cover no-repeat;
  }
  .rim {
    padding: 6px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    backdrop-filter: blur(14px) saturate(1.15);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 30px 60px -28px rgba(8, 24, 15, 0.65);
  }
  .paper {
    border-radius: 17px;
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgba(18, 40, 26, 0.14),
      0 10px 24px -14px rgba(18, 40, 26, 0.35);
  }

  .cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px 12px 16px;
  }
  .cap-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink-dark);
  }
  .card--big .cap-title {
    font-size: clamp(17px, 1.4vw, 20px);
  }
  /* The title's button reaches over the whole tile. */
  .open {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .open::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: 20px;
  }
  .open:focus-visible {
    outline: none;
  }
  .plus {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: var(--deep);
    background: var(--mist);
    transition:
      background 250ms var(--ease),
      color 250ms var(--ease);
  }
  .card:hover .plus {
    color: #ffffff;
    background: var(--deep);
  }

  /* ------------------------------------------------ detail view */

  :global(html:has(dialog.sheet[open])) {
    overflow: hidden;
  }
  .sheet {
    width: min(1100px, calc(100% - 48px));
    max-width: none;
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 28px;
    overflow: hidden;
    color: var(--ink-dark);
    background: #ffffff;
    color-scheme: light;
    box-shadow: 0 40px 100px -30px rgba(8, 24, 15, 0.6);
  }
  .sheet[open] {
    animation: sheet-in 480ms var(--ease);
  }
  .sheet::backdrop {
    background: rgba(14, 26, 18, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .sheet[open]::backdrop {
    animation: scrim-in 360ms var(--ease);
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
  }
  @keyframes scrim-in {
    from {
      opacity: 0;
    }
  }
  .sheet-in {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 48px);
  }
  .sheet-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--moss);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: inset 0 0 0 1px var(--ghost);
    cursor: pointer;
    transition:
      background 250ms var(--ease),
      transform 250ms var(--ease);
  }
  .close:hover {
    background: var(--wash);
  }
  .close:focus-visible {
    outline: 2px solid var(--deep);
    outline-offset: 2px;
    border-radius: 50%;
  }
  .close:active {
    transform: scale(0.94);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 3vw, 44px);
    padding: clamp(22px, 3vw, 36px);
  }
  .panel[hidden] {
    display: none;
  }
  .panel:not([hidden]) {
    animation: panel-in 420ms var(--ease);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .panel-text {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 16px;
    padding: 8px 0 8px 6px;
  }
  .n {
    display: inline-grid;
    place-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--deep);
    background: rgba(47, 122, 85, 0.1);
    box-shadow: inset 0 0 0 1px rgba(47, 122, 85, 0.2);
  }
  .panel-title {
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--ink-dark);
  }
  .panel-body {
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--ink-mid);
  }
  .points {
    display: grid;
    gap: 12px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-dark);
  }
  .points svg {
    flex: none;
    margin-top: 3px;
  }
  .panel-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 420px;
    padding: clamp(18px, 3vw, 36px);
    border-radius: 22px;
    overflow: hidden;
    isolation: isolate;
    background: #1a3326;
  }
  .paper--detail {
    padding: 14px;
  }

  .sheet-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px clamp(14px, 2vw, 22px) 14px;
    background: var(--wash);
  }
  .step {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 8px 14px;
    border: 0;
    border-radius: 14px;
    color: var(--moss);
    background: none;
    text-align: left;
    cursor: pointer;
    transition: background 250ms var(--ease);
  }
  .step:hover {
    background: #ffffff;
  }
  .step svg {
    flex: none;
    color: var(--deep);
    transition: transform 300ms var(--ease);
  }
  .step:hover svg {
    transform: translateX(-3px);
  }
  .step--next {
    text-align: right;
  }
  .step--next:hover svg {
    transform: translateX(3px);
  }
  .step-text {
    display: grid;
    min-width: 0;
  }
  .step-text small {
    font-size: 12.5px;
    color: var(--moss-3);
  }
  .step-text b {
    overflow: hidden;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet[open],
    .panel:not([hidden]) {
      animation: none;
    }
    .card:hover {
      transform: none;
    }
  }

  /* ------------------------------------------------ narrower */

  /* Tablets: four columns, five rows. */
  @media (max-width: 1080px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(140px, calc((100svh - 200px) / 5), 180px);
    }
  }

  @media (max-width: 760px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel-visual {
      min-height: 0;
    }
    /* Clear the close button. */
    .panel-text {
      padding-right: 48px;
    }
  }

  /* Phones: two columns, and the credentials tile lies down to one row
     (the brain keeps two, for its folder list), so the grid runs about a
     screen and a half. */
  @media (max-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 130px;
      gap: 10px;
    }
    .tile-credentials {
      grid-row: span 1;
    }
    .art {
      padding: 8px;
    }
    .cap {
      padding: 8px 10px 10px 12px;
    }
    .cap-title,
    .card--big .cap-title {
      font-size: 14px;
    }
    /* The whole tile is the tap target; the plus would only crowd the label. */
    .plus {
      display: none;
    }
    /* A sheet from the bottom edge. */
    .sheet {
      width: 100%;
      max-height: 92dvh;
      margin: auto 0 0;
      border-radius: 24px 24px 0 0;
    }
    .sheet-in {
      max-height: 92dvh;
    }
    .panel {
      padding: 14px 14px 24px;
    }
    .panel-visual {
      padding: 14px;
      border-radius: 16px;
    }
    .step-text b {
      max-width: 34vw;
    }
  }
</style>
