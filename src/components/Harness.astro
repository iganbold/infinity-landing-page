---
import { harness as h } from "@/content/site";
import HarnessArt from "./HarnessArt.astro";
import HarnessDetail from "./HarnessDetail.astro";
import { backdropStyle as photo, type Backdrop } from "@/lib/assets";

const pad = (n: number) => String(n).padStart(2, "0");

/** Forest photos for backgrounds (same backdrops as How it works). */
const BACKDROPS: Backdrop[] = ["01-forest-floor", "02-woodland", "03-vista", "04-panorama"];

/** Tiles whose graphic sits on a photo, framed like the How it works cards. */
const PHOTO: Partial<Record<string, Backdrop>> = { sandbox: "01-forest-floor", skills: "01-forest-floor" };
/** The one tile in the brand green. */
const GREEN = "checks";
/** The detail view and each tile's "+" opener. Off for now; flip to true to bring them back. */
const showDetail = false;
/** Tiles left out of the grid for now; their content stays in site.ts. */
const HIDDEN = new Set(["access", "checks", "deployment", "audit"]);
/** The tiles that take a double-size cell; their graphic may grow to fill it. */
const BIG = new Set(["sandbox", "brain", "skills"]);
/** The tiles that take two columns of one row; their graphic may grow a little. */
const WIDE = new Set(["credentials", "code", "connectors"]);
const items = h.items.filter((item) => !HIDDEN.has(item.key));
/** The order tiles arrive in as the section scrolls in: scattered, one after another.
    Index 0 is the title tile, then one per item. */
const ARRIVE = [0, 3, 9, 6, 1, 10, 4, 7, 2, 5, 8];
---

<section class="harness" id="security" aria-labelledby="harness-title">
  <div class="frame">
    <header class="head">
      <h2 id="harness-title" class="title" data-reveal>{h.title}</h2>
      <p class="intro" data-reveal style="--d:1">{h.intro}</p>
      <span class="title-rule" aria-hidden="true" data-reveal style="--d:2"></span>
    </header>

    <!-- Bento grid: a text tile at the centre, then one tile per item, a few of them double size. Each item tile is a preview: one
         still graphic and a short label. The label's button opens the detail
         view; its hit area covers the tile. Rows take their height from the
         viewport, so on a desktop the whole grid fits on one screen; each
         graphic is zoomed to fit its tile. -->
    <ol class="bento">
      <li class="card card--text" data-reveal data-topo-panel style={`--d:${ARRIVE[0]}`}>
        <canvas class="topo" aria-hidden="true" data-topo></canvas>
        <span class="glow" aria-hidden="true"></span>
        <span class="glow-ring" aria-hidden="true"></span>
        <p class="tile-title">{h.tile}</p>
      </li>
      {
        items.map((item, i) => (
          <li
            class:list={["card", `tile-${item.key}`, { "card--big": BIG.has(item.key), "card--wide": WIDE.has(item.key) }]}
            data-tile
            data-reveal
            style={`--d:${ARRIVE[(i + 1) % ARRIVE.length]}`}
          >
            <div class:list={["art", { "art--photo": PHOTO[item.key], "art--green": item.key === GREEN }]} aria-hidden="true">
              {PHOTO[item.key] && <span class="art-bg" style={photo(PHOTO[item.key]!)} />}
              <div class="fit" data-fit data-fit-max={BIG.has(item.key) ? "1.6" : WIDE.has(item.key) ? "1.3" : undefined}>
                {PHOTO[item.key] ? (
                  <div class="rim">
                    <div class="paper">
                      <HarnessArt name={item.key} />
                    </div>
                  </div>
                ) : (
                  <HarnessArt name={item.key} />
                )}
              </div>
            </div>
            <div class="cap">
              <h3 class="cap-title">
                {showDetail ? (
                  <button type="button" class="open" data-open={item.key} aria-haspopup="dialog">
                    {item.label}
                  </button>
                ) : (
                  item.label
                )}
              </h3>
              {showDetail && (
                <span class="plus" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 14 14">
                    <path d="M7 2v10M2 7h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                </span>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Detail view: one dialog, one panel per tile; previous and next step
       through them in tile order. Off while showDetail is false. -->
  {
    showDetail && (
      <dialog class="sheet" data-sheet aria-labelledby={`hx-t-${items[0].key}`}>
        <div class="sheet-in">
          <button type="button" class="close" data-sheet-close aria-label={h.dialog.close}>
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M3 3l8 8M11 3l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
          <div class="sheet-scroll" data-sheet-scroll>
            {
              items.map((item, i) => (
                <article class="panel" data-panel={item.key} data-title={item.title} hidden={i !== 0}>
                  <div class="panel-text">
                    <span class="n mono">
                      {pad(i + 1)} / {pad(items.length)}
                    </span>
                    <h3 id={`hx-t-${item.key}`} class="panel-title">
                      {item.title}
                    </h3>
                    <p class="panel-body">{item.body}</p>
                    <ul class="points">
                      {item.points.map((p) => (
                        <li>
                          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                            <circle cx="8" cy="8" r="8" fill="#2f7a55" />
                            <path d="M4.8 8.2l2.1 2.1 4.3-4.6" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          {p}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="panel-visual" aria-hidden="true" data-hold>
                    <span class="art-bg" style={photo(BACKDROPS[i % BACKDROPS.length])} />
                    <div class="rim">
                      <div class="paper paper--detail">
                        <HarnessDetail name={item.key} />
                      </div>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
          <nav class="sheet-foot" aria-label="More of the harness">
            <button type="button" class="step" data-sheet-prev>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M13 8H3M7 4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="step-text">
                <small>{h.dialog.prev}</small>
                <b data-sheet-prev-name></b>
              </span>
            </button>
            <button type="button" class="step step--next" data-sheet-next>
              <span class="step-text">
                <small>{h.dialog.next}</small>
                <b data-sheet-next-name></b>
              </span>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </nav>
        </div>
      </dialog>
    )
  }
</section>

<!--
  Hairline figures (isometric line drawings that answer the pointer), in the
  tiles that carry one. The kernel is a classic script exposing HL; the host
  mounts each figure into its slot; the figures are modules, so they run after
  both. No tour: like every tile, a figure moves only under the pointer.
-->
<script is:inline src="/hairline/kernel.js"></script>
<script is:inline>
  window.hairline = (figure) => {
    const stage = document.querySelector(`[data-hairline-slot="${figure.name}"]`);
    if (!stage || stage.hasAttribute("data-hairline")) return;
    HL.inject(document);
    stage.setAttribute("data-hairline", figure.name);
    const svg = HL.mk("svg", { viewBox: "0 0 400 320", "aria-hidden": "true" }, stage);
    figure.mount({ stage, svg, read: { textContent: "" } }, figure.range[1]);
  };
</script>
<script is:inline type="module" src="/hairline/sandbox.js"></script>

<script>
  import { mountHarness } from "@/scripts/harness";

  import { mountTopography } from "@/scripts/topography";

  const section = document.querySelector<HTMLElement>("#security");
  if (section) mountHarness(section);

  // The title tile: the request demo sidebar's contour lines.
  const panel = section?.querySelector<HTMLElement>("[data-topo-panel]");
  const topo = panel?.querySelector<HTMLCanvasElement>("[data-topo]");
  if (panel && topo) mountTopography(topo, { pointerTarget: panel, opacity: 0.55 });
</script>

<style>
  .harness {
    position: relative;
    z-index: 1;
    /* How it works above already leaves its own room at the bottom. */
    padding: 0 0 clamp(120px, 16vh, 180px);
    --ink-dark: #16150f;
    --ink-mid: #57544a;
    /* The figures' moss ink and greens (scripts/figures.ts). */
    --moss: #17201a;
    --moss-2: #4b5a4f;
    --moss-3: #8a978d;
    --moss-4: #c2cbc3;
    --ghost: #e3e8e2;
    --wash: #f3f6f2;
    --deep: #2f7a55;
    --mid: #5fa37a;
    --pale: #cfe3c6;
    --mist: #e7f1e2;
  }

  /* ------------------------------------------------ head */

  /* Centred, like How it works: the title and the rule under it. */
  .head {
    display: grid;
    justify-items: center;
    gap: 22px;
    margin-bottom: clamp(32px, 4vw, 56px);
    text-align: center;
  }
  .title {
    font-size: clamp(34px, 5vw, 76px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink-dark);
    text-wrap: balance;
  }
  .intro {
    max-width: 700px;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.55;
    color: var(--ink-mid);
    text-wrap: balance;
  }
  .title-rule {
    width: 72px;
    height: 4px;
    border-radius: 4px;
    background: var(--deep);
  }

  /* ------------------------------------------------ bento */

  /* Desktop: six columns, four rows sized to the screen. The title, big and
     wide tiles are placed; the four small ones fill the gaps in order:

       S   S   ·   ·   B   B
       S   S   T   T   B   B
       Kr  Kr  ·   ·   M   M
       Cd  Cd  Cn  Cn  M   M

     (T title, S sandbox, B brain, M memory and skills, Kr keys,
      Cd code mode, Cn connectors) */
  .bento {
    --cols: 6;
    --gap: 12px;
    --row: clamp(160px, calc((100svh - 240px) / 4), 220px);
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-auto-rows: var(--row);
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card--text {
    grid-area: 2 / 3 / span 1 / span 2;
  }
  .tile-sandbox {
    grid-area: 1 / 1 / span 2 / span 2;
  }
  .tile-brain {
    grid-area: 1 / 5 / span 2 / span 2;
  }
  .tile-skills {
    grid-area: 3 / 5 / span 2 / span 2;
  }
  .tile-credentials {
    grid-area: 3 / 1 / span 1 / span 2;
  }
  .tile-code {
    grid-area: 4 / 1 / span 1 / span 2;
  }
  .tile-connectors {
    grid-area: 4 / 3 / span 1 / span 2;
  }
  /* The logo strip runs the width of its wide tile. */
  .tile-connectors :global(.cn) {
    width: 400px;
  }

  /* The text tile: the request demo sidebar's forest card (gradient,
     contour lines, turning edge glow), its text centred and set as large as
     the tile allows. */
  .card.card--text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 1.6vw, 22px);
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    container-type: inline-size;
    background:
      radial-gradient(70% 50% at 0% 0%, rgba(255, 214, 140, 0.14), transparent 70%),
      linear-gradient(160deg, #22432f 0%, #1d3a2b 55%, #142a1e 100%);
    box-shadow: 0 40px 80px -44px rgba(20, 45, 30, 0.6);
  }
  .card--text:hover {
    transform: none;
    box-shadow: 0 40px 80px -44px rgba(20, 45, 30, 0.6);
  }
  .card--text::before,
  .card--text::after {
    content: none;
  }
  .tile-title {
    font-size: min(10cqi, 56px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: #ffffff;
  }

  /* Contours under the edge glow; quieter behind the title. */
  .topo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(90% 55% at 50% 50%, rgba(0, 0, 0, 0.35), #000 100%);
    mask-image: radial-gradient(90% 55% at 50% 50%, rgba(0, 0, 0, 0.35), #000 100%);
  }

  /* Siri-style inner glow, as on the request demo sidebar: a slowly turning
     conic gradient cut to a thin band along the edges, blurred so the light
     softens inward. The tile's overflow clips the outer half. */
  @property --glow-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
  .glow,
  .glow-ring {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
  }
  .glow::before,
  .glow-ring::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(from var(--glow-angle), #ffcf7a, #d6f58a, #4fe3b0, #6cc4ff, #4fe3b0, #d6f58a, #ffcf7a);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: glow-spin 9s linear infinite;
  }
  .glow {
    filter: blur(18px) saturate(1.3);
  }
  .glow::before {
    padding: 14px;
  }
  /* A tighter, brighter edge on top, softly blurred. */
  .glow-ring {
    filter: blur(3px);
    opacity: 0.9;
  }
  .glow-ring::before {
    padding: 3px;
  }
  @keyframes glow-spin {
    to {
      --glow-angle: 360deg;
    }
  }

  /* Same white sheet as the comparison table above: the graphic inset at
     the top, the title under it. */
  .card {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
      inset 0 0 0 1px rgba(22, 21, 15, 0.06),
      0 18px 40px -30px rgba(30, 50, 35, 0.3);
    transition:
      transform 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }
  /* Tiles arrive one by one as the section comes in, in a scattered order
     (--d). Backwards fill, so once arrived the hover lift still applies. */
  .card.in {
    animation: card-in 760ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(var(--d, 0) * 70ms);
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
      filter: blur(4px);
    }
  }
  /* On hover, an iOS-style glow inside the edges in the brand's effect
     colours: a thin ring whose gradient turns, over a soft inner light. */
  .card::before,
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 450ms var(--ease);
  }
  .card::before {
    padding: 1.5px;
    background: conic-gradient(from var(--hx-spin), #ffcf7a, #d6f58a, #4fe3b0, #5fa37a, #ffcf7a);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .card::after {
    box-shadow:
      inset 14px 0 24px -14px rgba(255, 207, 122, 0.9),
      inset -14px 0 24px -14px rgba(79, 227, 176, 0.75),
      inset 0 14px 24px -14px rgba(214, 245, 138, 0.9),
      inset 0 -14px 24px -14px rgba(95, 163, 122, 0.75);
  }
  .card:hover::before,
  .card:hover::after {
    opacity: 1;
  }
  .card:hover::before {
    animation: hx-spin 4s linear infinite;
  }
  @property --hx-spin {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes hx-spin {
    to {
      --hx-spin: 360deg;
    }
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 0 1px rgba(22, 21, 15, 0.08),
      0 26px 50px -30px rgba(30, 50, 35, 0.45);
  }
  .card:active {
    transform: translateY(-1px) scale(0.995);
  }
  .card:has(.open:focus-visible) {
    outline: 2px solid var(--deep);
    outline-offset: 3px;
  }

  .art {
    position: relative;
    display: grid;
    place-items: center;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    min-height: 0;
    margin: 6px 6px 0;
    padding: 12px;
    border-radius: 15px;
    overflow: hidden;
    isolation: isolate;
    background: var(--wash);
  }
  /* The preview at its natural size; scripts/harness.ts zooms it down to fit. */
  .fit {
    width: max-content;
  }
  /* The green tile, with the dot texture of the Systems column. */
  .art--green {
    padding: 4px;
    background-color: var(--deep);
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.16) 1px, transparent 1.4px);
    background-size: 7px 7px;
  }
  /* Photo tiles: the forest behind a frosted rim and a paper sheet. */
  .art--photo {
    background: #1a3326;
  }
  .art-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: center 62% / cover no-repeat;
  }
  .rim {
    padding: 6px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    backdrop-filter: blur(14px) saturate(1.15);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 30px 60px -28px rgba(8, 24, 15, 0.65);
  }
  .paper {
    padding: 14px;
    border-radius: 17px;
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgba(18, 40, 26, 0.14),
      0 10px 24px -14px rgba(18, 40, 26, 0.35);
  }

  .cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px 12px 16px;
  }
  /* Room for two lines on every tile, so every graphic gets the same height. */
  .cap-title {
    display: flex;
    align-items: center;
    min-height: 2.4em;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink-dark);
  }
  /* The title's button reaches over the whole tile. */
  .open {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .open::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: 20px;
  }
  .open:focus-visible {
    outline: none;
  }
  .plus {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: var(--deep);
    background: var(--mist);
    transition:
      background 250ms var(--ease),
      color 250ms var(--ease);
  }
  .card:hover .plus {
    color: #ffffff;
    background: var(--deep);
  }

  /* ------------------------------------------------ detail view */

  :global(html:has(dialog.sheet[open])) {
    overflow: hidden;
  }
  .sheet {
    width: min(1100px, calc(100% - 48px));
    max-width: none;
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 28px;
    overflow: hidden;
    color: var(--ink-dark);
    background: #ffffff;
    color-scheme: light;
    box-shadow: 0 40px 100px -30px rgba(8, 24, 15, 0.6);
  }
  .sheet[open] {
    animation: sheet-in 480ms var(--ease);
  }
  .sheet::backdrop {
    background: rgba(14, 26, 18, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .sheet[open]::backdrop {
    animation: scrim-in 360ms var(--ease);
  }
  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
  }
  @keyframes scrim-in {
    from {
      opacity: 0;
    }
  }
  .sheet-in {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 48px);
  }
  .sheet-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--moss);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: inset 0 0 0 1px var(--ghost);
    cursor: pointer;
    transition:
      background 250ms var(--ease),
      transform 250ms var(--ease);
  }
  .close:hover {
    background: var(--wash);
  }
  .close:focus-visible {
    outline: 2px solid var(--deep);
    outline-offset: 2px;
    border-radius: 50%;
  }
  .close:active {
    transform: scale(0.94);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 3vw, 44px);
    padding: clamp(22px, 3vw, 36px);
  }
  .panel[hidden] {
    display: none;
  }
  .panel:not([hidden]) {
    animation: panel-in 420ms var(--ease);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .panel-text {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 16px;
    padding: 8px 0 8px 6px;
  }
  .n {
    display: inline-grid;
    place-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--deep);
