---
import { howItWorks as h } from "@/content/site";

/** One figure per step (scripts/figures.ts), in step order, with what it shows for screen readers. */
const FIGURES = [
  { name: "outcome", means: "Three rings around one centre: the outcome to achieve, a gauge for how success is measured, and a dashed boundary marking the System's role." },
  { name: "dock", means: "The System learns from what the team knows, how it works and its tools, and its reach spreads across the organization to every corner." },
  { name: "table", means: "The team and the System on side-by-side tracks, joined by four moves: hand off, check in, the System asks, and the team gives direction." },
  { name: "learn", means: "A chain of projects, each starting higher than the last, with what worked and what didn't collected in the company brain." },
];
/**
 * Backdrop behind each figure card, one per step: forest floor → woodland →
 * vista → panorama, a zoom-out from the ground to the horizon as the steps
 * widen in scope. WebP first, JPEG where WebP isn't supported.
 */
const BACKDROPS = ["01-forest-floor", "02-woodland", "03-vista", "04-panorama"].map((n) => `/primitives/${n}`);
---

<section class="how" id="how-it-works" aria-labelledby="how-title">
  <div class="frame">
    <header class="head">
      <h2 id="how-title" class="title" data-reveal>{h.title}</h2>
      <span class="title-rule" aria-hidden="true" data-reveal style="--d:1"></span>
    </header>

    <ol class="steps">
      {
        h.steps.map((step, i) => (
          <li class:list={["step", { "step--flip": i % 2 === 1 }]}>
            <figure class="visual" data-reveal data-parallax-panel>
              <span
                class="v-bg"
                aria-hidden="true"
                style={`background-image: image-set(url(${BACKDROPS[i]}.webp) type("image/webp"), url(${BACKDROPS[i]}.jpg) type("image/jpeg"))`}
              />
              <span class="v-lens" aria-hidden="true" data-shape-blur={`${BACKDROPS[i]}.webp`} />
              <div class="fig-card">
                <div class="fig-paper">
                  <div class="v-head">
                    <figcaption class="v-cap">{step.visual}</figcaption>
                    <span class="v-status" aria-hidden="true">
                      <span class="v-dot" />
                      <span class="v-read" />
                    </span>
                  </div>
                  <div class="fig-stage" role="img" aria-label={FIGURES[i].means} data-figure={FIGURES[i].name} />
                  <div class="v-rail" />
                </div>
              </div>
            </figure>
            <div class="text" data-reveal style="--d:1">
              <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-body">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="closing" data-reveal>
      <h3 class="closing-title">{h.closing.title}</h3>
      <p class="closing-body">{h.closing.body}</p>
      <a href={h.closing.cta.href} class="closing-cta">
        {h.closing.cta.label}
        <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 12L12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { mountFigure, type FigureName } from "@/scripts/figures";
  import { mountShapeBlur } from "@/scripts/shape-blur";

  // Figures: filled 2D graphs that tour their states and answer the pointer;
  // each writes its status into the line above it and keeps the rail below.
  document.querySelectorAll<HTMLElement>("[data-figure]").forEach((stage) => {
    const paper = stage.parentElement!;
    mountFigure(stage, stage.dataset.figure as FigureName, {
      readout: paper.querySelector<HTMLElement>(".v-read"),
      rail: paper.querySelector<HTMLElement>(".v-rail"),
    });
  });

  // Parallax: each card's backdrop drifts against the scroll, so the card
  // seems to float above it. Only panels on screen are updated, once per frame.
  const panels = [...document.querySelectorAll<HTMLElement>("[data-parallax-panel]")];
  if (panels.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const live = new Set<HTMLElement>();
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = innerHeight;
      for (const el of live) {
        const r = el.getBoundingClientRect();
        // -1 when the panel's middle is at the bottom of the screen, 1 at the top
        const t = Math.max(-1, Math.min(1, (vh / 2 - (r.top + r.height / 2)) / (vh / 2 + r.height / 2)));
        (el.firstElementChild as HTMLElement).style.transform = `translate3d(0, ${(t * r.height * 0.18).toFixed(1)}px, 0)`;
      }
    };
    const kick = () => { if (!raf && live.size) raf = requestAnimationFrame(update); };
    const io = new IntersectionObserver((es) => {
      for (const e of es) e.isIntersecting ? live.add(e.target as HTMLElement) : live.delete(e.target as HTMLElement);
      kick();
    });
    panels.forEach((el) => io.observe(el));
    addEventListener("scroll", kick, { passive: true });
    addEventListener("resize", kick, { passive: true });
  }

  // Shape blur on the backdrop: hovering the photo blurs it in a rect around
  // the card, sharp at the card's edge and softer toward the panel's, most
  // under the pointer. The card stays crisp; the host sits under it, so only
  // the exposed photo answers the hover.
  if (matchMedia("(hover: hover)").matches) {
    document.querySelectorAll<HTMLElement>("[data-shape-blur]").forEach((el) => {
      const panel = el.parentElement!;
      mountShapeBlur(el, {
        src: el.dataset.shapeBlur!,
        // Redraw the photo exactly where the parallax layer has it (.v-bg).
        box: panel.querySelector<HTMLElement>(".v-bg")!,
        position: [0.5, 0.62],
        core: panel.querySelector<HTMLElement>(".fig-card")!,
        radius: 20,
        blur: 14,
        lensSize: 0.4,
        lensSoftness: 0.8,
        rest: 0.45,
        chroma: 0.4,
      });
    });
  }
</script>


<style>
  .how {
    position: relative;
    z-index: 1;
    padding: clamp(80px, 12vh, 140px) 0 clamp(120px, 16vh, 180px);
    --ink-dark: #16150f;
    --ink-mid: #57544a;
  }

  .head {
    display: grid;
    justify-items: center;
    gap: 22px;
    margin-bottom: clamp(56px, 8vw, 110px);
    text-align: center;
  }
  .title {
    max-width: 16ch;
    font-size: clamp(34px, 5vw, 76px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink-dark);
  }
  /* Short brand rule under the headline. */
  .title-rule {
    width: 72px;
    height: 4px;
    border-radius: 4px;
    background: #2f7a55;
  }

  /* ------------------------------------------------ steps */

  .steps {
    display: grid;
    gap: clamp(56px, 8vw, 120px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }
  /* Mirror the row: visual on the right, still in the wider column. */
  .step--flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
  }
  .step--flip .visual {
    order: 2;
  }
  .step--flip .text {
    justify-self: end;
  }

  .text {
    display: grid;
    justify-items: start;
    gap: 16px;
    max-width: 440px;
  }
  .n {
    display: inline-grid;
    place-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 12px;
    color: #2f7a55;
    background: rgba(47, 122, 85, 0.1);
    box-shadow: inset 0 0 0 1px rgba(47, 122, 85, 0.2);
  }
  .step-title {
    font-size: clamp(26px, 2.6vw, 40px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink-dark);
  }
  .step-body {
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--ink-mid);
  }

  /* Figure panel: an image backdrop framing a white card that holds the
     figure. */
  .visual {
    position: relative;
    margin: 0;
    padding: clamp(14px, 2.6vw, 30px);
    border-radius: 28px;
    overflow: hidden;
    isolation: isolate;
    background: #1a3326;
    box-shadow: 0 36px 70px -40px rgba(20, 45, 30, 0.55);
  }
  /* The backdrop: taller than the panel so it can drift with the scroll. */
  .v-bg {
    position: absolute;
    inset: -22% 0;
    z-index: -1;
    background: center 62% / cover no-repeat;
    will-change: transform;
  }
  /* Hover target for the shape blur: covers the panel under the card, so the
     pointer only reaches it on the exposed photo. Its canvas redraws the photo
     blurred over the CSS one, and fades in on hover. */
  .v-lens {
    position: absolute;
    inset: 0;
  }
  .v-lens :global(canvas) {
    opacity: 0;
    transition: opacity 500ms var(--ease);
  }
  .v-lens:hover :global(canvas) {
    opacity: 1;
  }
  /* The card: a frosted rim that takes its tint from the photo, holding a
     paper sheet with the caption and status, the figure, and its rail. */
  .fig-card {
    position: relative;
    padding: 7px;
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    backdrop-filter: blur(14px) saturate(1.15);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 30px 60px -28px rgba(8, 24, 15, 0.65);
  }
  .fig-paper {
    position: relative;
    border-radius: 19px;
    overflow: hidden;
    background: linear-gradient(180deg, #ffffff 55%, #f8faf7 100%);
    box-shadow:
      0 1px 2px rgba(18, 40, 26, 0.14),
      0 10px 24px -14px rgba(18, 40, 26, 0.35);
  }

  .v-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 16px;
    padding: 18px 20px 0;
  }
  .v-cap {
    font-size: clamp(14px, 1.2vw, 17px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #17201a;
  }
  /* Live status: what the System is doing in the state on show. */
  .v-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    pointer-events: none;
  }
  .v-read {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: #4b5a4f;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .v-dot {
    position: relative;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2f7a55;
  }
  .v-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1.5px solid rgba(47, 122, 85, 0.45);
    animation: v-beat 2.4s var(--ease) infinite;
  }
  @keyframes v-beat {
    from {
      transform: scale(0.5);
      opacity: 1;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .fig-stage {
    width: 100%;
  }
  .fig-stage :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    font-variant-numeric: tabular-nums;
  }

  /* The rail: one segment per state. Past ones are filled, the one on show
     fills green while the tour holds it (--p, set by figures.ts). */
  .v-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 6px;
    padding: 0 20px 12px;
  }
  .v-rail :global(button) {
    position: relative;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    cursor: pointer;
  }
  .v-rail :global(button)::before,
  .v-rail :global(i) {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    margin-top: -1.5px;
    border-radius: 3px;
  }
  .v-rail :global(button)::before {
    background: #e3e8e2;
    transition: background 180ms ease;
  }
  .v-rail :global(i) {
    background: #8a978d;
    transform: scaleX(var(--p, 0));
    transform-origin: left center;
  }
  .v-rail :global(button.on i) {
    background: #2f7a55;
  }
  .v-rail :global(button:focus-visible) {
    outline: 2px solid #2f7a55;
    outline-offset: 1px;
  }
  @media (hover: hover) {
    .v-rail :global(button:hover)::before {
      background: #c2cbc3;
    }
  }

  /* ------------------------------------------------ closing */

  .closing {
    display: grid;
    justify-items: center;
    gap: 14px;
    margin-top: clamp(80px, 11vw, 150px);
    padding: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 48px);
    border-radius: 28px;
    text-align: center;
    background:
      radial-gradient(70% 80% at 50% 0%, rgba(255, 236, 200, 0.55), transparent 70%),
      linear-gradient(180deg, #f2f4ec 0%, #e5ebdf 100%);
    box-shadow: inset 0 0 0 1px rgba(40, 70, 50, 0.07);
  }
  .closing-title {
    max-width: 20ch;
    font-size: clamp(26px, 3vw, 44px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink-dark);
  }
  .closing-body {
    max-width: 44ch;
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.6;
    color: var(--ink-mid);
  }

  /* Same pill as the other "Book a demo" buttons on the light sections. */
  .closing-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    margin-top: 12px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    color: #f7f1e3;
    background: #16150f;
    transition:
      background 250ms var(--ease),
      box-shadow 250ms var(--ease);
  }
  .closing-cta:hover {
    background: #1f3a2f;
    box-shadow: 0 14px 30px -14px rgba(31, 58, 47, 0.6);
  }
  .closing-cta svg {
    transition: transform 300ms var(--ease);
  }
  .closing-cta:hover svg {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .v-dot::after {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .step {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .step--flip {
      grid-template-columns: 1fr;
    }
    .step--flip .visual {
      order: 0;
    }
    .step--flip .text {
      justify-self: start;
    }
    .visual {
      border-radius: 20px;
    }
    .closing {
      border-radius: 22px;
    }
  }
</style>
