---
import { footer as f, site } from "@/content/site";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="footer" id="contact" aria-labelledby="footer-title">
  <div class="panel frame" data-topo-panel>
    <canvas class="topo" aria-hidden="true" data-topo></canvas>
    <div class="cta-block">
      <h2 id="footer-title" class="title" data-reveal>{f.title}</h2>
      <p class="body" data-reveal style="--d:1">{f.body}</p>
      <div class="actions" data-reveal style="--d:2">
        <a href={f.demo.href} class="btn btn-solid">
          {f.demo.label}
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4 12L12 4M5.5 4H12v6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href={f.contact.href} class="btn btn-ghost">{f.contact.label}</a>
      </div>
    </div>

    <div class="bottom">
      <a href="/" class="brand" aria-label={`${site.name} home`}><Logo size={24} tone="white" /></a>
      <nav aria-label="Footer">
        <ul class="links">
          {f.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={f.contact.href}>{f.contact.label}</a></li>
        </ul>
      </nav>
      <p class="legal">© {year} {site.name}. {f.legal}</p>
    </div>
  </div>
</footer>

<script>
  import { mountTopography } from "@/scripts/topography";

  const panel = document.querySelector<HTMLElement>("[data-topo-panel]");
  const canvas = panel?.querySelector<HTMLCanvasElement>("[data-topo]");
  if (panel && canvas) mountTopography(canvas, { pointerTarget: panel, opacity: 0.55 });
</script>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: 0 0 clamp(24px, 3vw, 40px);
  }

  /* Deep forest panel: bookends the green the page starts with. */
  /* Animated contour lines behind the content. */
  .topo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* Quieter under the copy on the left, fuller on the right. */
    -webkit-mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.5) 40%, #000 75%);
    mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.5) 40%, #000 75%);
  }
  .panel > :not(.topo) {
    position: relative;
  }

  .panel {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(56px, 8vw, 104px);
    padding: clamp(48px, 7vw, 96px) clamp(28px, 6vw, 88px) clamp(28px, 3vw, 40px);
    border-radius: 32px;
    overflow: hidden;
    color: #f2f4ec;
    background:
      radial-gradient(60% 70% at 85% 0%, rgba(255, 214, 140, 0.16), transparent 70%),
      radial-gradient(60% 70% at 10% 100%, rgba(92, 219, 180, 0.12), transparent 70%),
      linear-gradient(160deg, #22432f 0%, #1d3a2b 55%, #142a1e 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .cta-block {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  .title {
    white-space: pre-line;
    font-size: clamp(34px, 4.6vw, 68px);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.035em;
    color: #ffffff;
  }
  .body {
    max-width: 46ch;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: rgba(242, 244, 236, 0.72);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 50px;
    padding: 0 24px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    transition:
      background 250ms var(--ease),
      box-shadow 250ms var(--ease),
      color 250ms var(--ease);
  }
  .btn-solid {
    color: #16150f;
    background: #faf8f3;
  }
  .btn-solid:hover {
    background: #ffffff;
    box-shadow: 0 14px 34px -14px rgba(255, 236, 200, 0.6);
  }
  .btn-solid svg {
    transition: transform 300ms var(--ease);
  }
  .btn-solid:hover svg {
    transform: translate(2px, -2px);
  }
  .btn-ghost {
    color: #f2f4ec;
    box-shadow: inset 0 0 0 1px rgba(242, 244, 236, 0.3);
  }
  .btn-ghost:hover {
    background: rgba(242, 244, 236, 0.08);
    box-shadow: inset 0 0 0 1px rgba(242, 244, 236, 0.5);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(242, 244, 236, 0.12);
  }
  .brand {
    display: inline-flex;
    color: #f2f4ec;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    font-size: 14px;
    color: rgba(242, 244, 236, 0.7);
    transition: color 200ms var(--ease);
  }
  .links a:hover {
    color: #ffffff;
  }
  .legal {
    margin-left: auto;
    font-size: 13px;
    color: rgba(242, 244, 236, 0.45);
  }

  @media (max-width: 860px) {
    .panel {
      border-radius: 24px;
    }
    .actions {
      width: 100%;
    }
    .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
    .legal {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
