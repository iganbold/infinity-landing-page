---
import "@/styles/global.css";
import { site } from "@/content/site";
import Nav from "@/components/Nav.astro";

/** Nav is hidden for now; flip to true to bring back the top bar and bottom dock. */
const showNav = false;

interface Props {
  title?: string;
  description?: string;
  /** Share image, a path under public/ (1200 × 630). */
  image?: string;
}
const { title = `${site.name} — ${site.tagline}`, description = site.description, image = "/og-image.jpg" } = Astro.props;
// Share tags need absolute URLs, on the site's own domain (astro.config.mjs `site`).
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d3a2b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`The ${site.name} mark over a sunrise landscape`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {showNav && <Nav />}
    <main id="main">
      <slot />
    </main>
    <script>
      import "@/scripts/reveal";
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: 16px;
    top: 16px;
    transform: translateY(-200%);
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--green);
    color: var(--on-green);
    font-size: 14px;
    transition: transform 200ms var(--ease);
  }
  .skip:focus {
    transform: none;
  }
</style>
