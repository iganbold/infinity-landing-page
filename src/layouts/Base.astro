---
import "@/styles/global.css";
import { site } from "@/content/site";
import Nav from "@/components/Nav.astro";

/** Nav is hidden for now; flip to true to bring back the top bar and bottom dock. */
const showNav = false;

interface Props {
  title?: string;
  description?: string;
  /** Share image, a path under public/ (1200 × 630). */
  image?: string;
}
const { title = `${site.name} — ${site.tagline}`, description = site.description, image = "/og-image.jpg" } = Astro.props;
// Share tags need absolute URLs, on the site's own domain (astro.config.mjs `site`).
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const home = new URL("/", Astro.site);
/** Structured data: who we are, the site, and this page. */
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${home}#organization`,
      name: site.name,
      url: home.href,
      logo: new URL("/icon-512.png", Astro.site).href,
      description: site.description,
    },
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: site.name,
      url: home.href,
      publisher: { "@id": `${home}#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${url}#webpage`,
      url: url.href,
      name: title,
      description,
      isPartOf: { "@id": `${home}#website` },
      primaryImageOfPage: imageUrl.href,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d3a2b" />
    <link rel="canonical" href={url} />
    <!-- Icons: .ico and PNG for Google and older browsers, SVG for the rest. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`The ${site.name} mark over a sunrise landscape`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={`The ${site.name} mark over a sunrise landscape`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {showNav && <Nav />}
    <main id="main">
      <slot />
    </main>
    <script>
      import "@/scripts/reveal";
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: 16px;
    top: 16px;
    transform: translateY(-200%);
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--green);
    color: var(--on-green);
    font-size: 14px;
    transition: transform 200ms var(--ease);
  }
  .skip:focus {
    transform: none;
  }
</style>
